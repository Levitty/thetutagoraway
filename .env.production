# Production build config. Vite reads this automatically on `npm run build`.
# The live HOREB engine the app calls. If unreachable, the app falls back to
# the in-browser JS engine, so this is safe.

# The HOREB live tutor (owner, 11 Nov 2026: test it live). The page opens only for signed-in admins;
# the voice-tutor functions also need VOICE_TUTOR_ENABLED=1 and the email on VOICE_TUTOR_ALLOWLIST
# (Supabase secrets), so nobody else can start a session. Adult testers only until consent is built.
VITE_VOICE_TUTOR=1
