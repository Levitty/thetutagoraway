    "coverage:outcomes": "node scripts/coverage-outcomes.mjs",
    "review:precheck": "node scripts/review-precheck.mjs",
    "audit:drift": "node scripts/function-drift.mjs",
    "build:rocket-fn": "node scripts/build-rocket-guide-fn.mjs",
    "build:voice-tutor-fn": "node scripts/build-voice-tutor-fn.mjs",
    "redteam:rocket": "node scripts/rocket-redteam.mjs",
    "build:wa-sign-in-fn": "node scripts/build-wa-sign-in-fn.mjs",
    "build:review": "node scripts/build-question-review.mjs",
    "horeb:try": "VITE_HOREB_ALL_FAMILIES=1 vite --open /qa/question-bank/index.html"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.0.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@supabase/supabase-js": "^2.39.0",
    "agora-rtc-sdk-ng": "^4.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^2.0.0"
  }
