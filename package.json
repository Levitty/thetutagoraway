{
  "name": "tutagora",
  "version": "1.0.0",
  "description": "Learn from Kenya's best tutors - Online tutoring platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-subject-registry.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:engine": "node scripts/test-engine.mjs",
    "audit:answers": "node scripts/audit-answers.mjs",
    "audit:check": "node scripts/simulate-check.mjs",
    "build:report-fn": "node scripts/build-weekly-report-fn.mjs",
    "build:marking-fn": "node scripts/build-mark-composition-fn.mjs",
    "build:school-fn": "node scripts/build-school-practice-fn.mjs",
    "audit:items": "node scripts/audit-new-items.mjs",
    "audit:gradefit": "node scripts/audit-grade-fit.mjs",
    "audit:dupes": "node scripts/audit-rung-dupes.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:content": "node engine/scripts/quality_gate.mjs",
    "registry": "node scripts/build-subject-registry.mjs",
    "subject:map": "node scripts/build-subject-map.mjs",
    "subject:new": "node scripts/new-subject.mjs",
    "subject:review": "node scripts/build-subject-review-doc.mjs",
    "build:english-g5": "node scripts/build-english-g5.mjs",
