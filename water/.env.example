# Copy to .env.local and fill in. Never commit .env.local.
#
# The NEW Supabase project (not the tutoring one), created under the same
# Supabase account you already pay for.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Your Paystack PUBLIC key. Public by design — it identifies the account the
# money goes to and can do nothing on its own. Use pk_test_... until you have
# taken a real payment end to end.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
