     "code": "CRES.G1.CHRIST.SHARING.SHARE_HOME.M_C1_SH_TOWEL",
     "listen_for": [
      "Yes"
     ],
     "ask": "Is a bathing towel shared?",
     "repair": "Two baskets: shared and personal."
    },
    {
     "code": "CRES.G1.CHRIST.SHARING.SHARE_HOME.M_C1_SH_GREEDY",
     "listen_for": [
      "Whoever grabs first"
     ],
     "ask": "Food is on the table. Who should get it first?",
     "repair": "Role-play serving fairly."
    },
    {
     "code": "CRES.G1.CHRIST.SHARING.SHARE_HOME.M_C1_SH_TV_MINE",
     "listen_for": [
      "Only me"
     ],
     "ask": "Who uses the TV at home?",
     "repair": "Take turns choosing in role-play."
    },
    {
     "code": "CRES.G1.CHRIST.SHARING.SHARE_HOME.M_C1_SH_WHY",
     "listen_for": [
      "Because they must"
     ],
     "ask": "Why do families share?",
     "repair": "Ask how it feels when someone shares with you."
    }
   ],
