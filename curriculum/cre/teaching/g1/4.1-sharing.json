  {
   "skill": "CRES.G1.CHRIST.SHARING.SHARE_HOME",
   "key_step": "The child names items shared at home and says sharing shows love.",
   "floor": {
    "prerequisite": "Takes turns.",
    "question": "Whose turn is it after yours?",
    "answer": "The next child's"
   },
   "representations": [
    "picture cards",
    "two baskets",
    "a family meal role-play"
   ],
   "steps": [
    "Name items shared at home.",
    "Sort shared and personal.",
    "Say why we share.",
    "Act out sharing a meal."
   ],
   "contexts": [
    "supper",
    "watching TV",
    "sharing a bed with a sibling"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Draw a table, a toothbrush and a pot."
    },
    {
     "beat": "point",
     "do": "Point at the toothbrush.",
     "say": "Shared or personal?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to say personal."
    },
    {
     "beat": "reveal",
     "do": "Circle the shared items."
    }
   ],
   "misconceptions": [
