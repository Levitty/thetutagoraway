   "floor": {
    "prerequisite": "Knows 60 seconds make a minute.",
    "question": "Seconds in 3 minutes",
    "answer": "180"
   },
   "representations": [
    "a clock",
    "steps of 60",
    "hours and minutes"
   ],
   "steps": [
    "Seconds to minutes: divide by 60.",
    "Minutes to hours: divide by 60.",
    "Whole hours first.",
    "Minutes left over."
   ],
   "contexts": [
    "a long race",
    "a school lesson",
    "a bus ride"
   ],
   "board": [
