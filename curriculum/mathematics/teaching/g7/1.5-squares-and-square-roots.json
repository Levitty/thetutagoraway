 "sources": [],
 "notes": "Official outcomes a and b are tested; c is an attitude. Square roots are of perfect squares only (outcome b). One skill places a root between two whole numbers using perfect squares as anchors: it is a way of checking a root and is kept, with its limit named. Squares and roots in the Grade 6 map go up to 100 and 10,000.",
 "skills": [
  {
   "skill": "MATH.G7.NUMBER.SQUARES_AND_SQUARE_ROOTS.SQUARE_WHOLE_NUMBER",
   "key_step": "The child says a square is the number multiplied by itself and shows it as a square of dots.",
   "floor": {
    "prerequisite": "Knows multiplication facts.",
    "question": "7 x 7",
    "answer": "49"
   },
   "representations": [
    "a square of dots",
    "the product",
    "the area of a tile"
   ],
   "steps": [
    "Draw a square with sides of that number.",
    "Count the dots as rows of that number.",
    "Write the multiplication.",
    "For multiples of 10 count the zeros."
   ],
   "contexts": [
    "tiles on a floor",
    "plots of land",
    "seedlings in rows"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a 7 by 7 square of dots."
    },
    {
     "beat": "point",
     "do": "Point at one row.",
     "say": "How many rows are there?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to say."
    }
   ],
   "misconceptions": [
