     "code": "MATH.G7.GEOMET.GEOMETRICAL_CONSTRUCTION.MEASURE_ANGLES_PROTRACTOR.M_PROTRACTOR_NOT_ALIGNED",
     "listen_for": [
      "edge on the corner"
     ],
     "ask": "Where is the centre mark?",
     "repair": "On the corner."
    }
   ],
   "checks": [
