     "listen_for": [
      "the bottle tops"
     ],
     "ask": "Which side sank?",
     "repair": "The stone's: it is heavier."
    },
    {
     "code": "MATH.G2.MEASUR.MASS.MEASURE_FIXED_MASS.M_FM_MIXED_UNITS",
     "listen_for": [
      "yes"
     ],
     "ask": "Are the stones the same?",
     "repair": "No: use one kind."
    },
    {
     "code": "MATH.G2.MEASUR.MASS.MEASURE_FIXED_MASS.M_FM_HEAVIER_UNIT_MORE",
     "listen_for": [
      "more"
     ],
     "ask": "Which unit balances with fewer?",
     "repair": "The heavier stones: fewer."
    },
    {
     "code": "MATH.G2.MEASUR.MASS.MEASURE_FIXED_MASS.M_FM_NOT_LEVEL",
     "listen_for": [
      "yes"
     ],
     "ask": "Is the beam level?",
     "repair": "No: add more."
    }
   ],
   "checks": [
    {
     "question": "The bag's side sinks. Heavier or lighter than the tops?",
     "answer": "heavier",
     "shows": "reading"
    },
