 "sources": [],
 "notes": "Outcomes a to c are KICD's words; d is attitudinal. Mass is measured on an improvised beam balance with items of the same mass, then against a 1 kg mass (or an empty 1 kg packet filled).",
 "skills": [
  {
   "skill": "MATH.G2.MEASUR.MASS.MEASURE_FIXED_MASS",
   "key_step": "The child adds equal items to one pan until the beam is level, then counts them.",
   "floor": {
    "prerequisite": "Compares heavier and lighter (Grade 1).",
    "question": "Which is heavier: a stone or a leaf?",
    "answer": "a stone"
   },
   "representations": [
    "an improvised beam balance",
    "bottle tops of one kind",
    "a picture of a balance"
   ],
   "steps": [
    "Object in one pan.",
    "Add equal items to the other.",
    "Stop when level.",
    "Count the items."
   ],
   "contexts": [
    "a coat hanger balance",
    "bottle tops",
    "stones of one size"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a balance: a book on one side, tipped down."
    },
    {
     "beat": "point",
     "do": "Point at the low side.",
     "say": "Which is heavier?"
    },
    {
     "beat": "pause",
     "do": "Wait for: the book."
    },
    {
     "beat": "child_draws",
     "do": "The child adds bottle tops until level."
    },
    {
     "beat": "reveal",
     "do": "Write the count."
    }
   ],
   "misconceptions": [
