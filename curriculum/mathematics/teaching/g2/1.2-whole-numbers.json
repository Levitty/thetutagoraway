   "skill": "MATH.G2.NUMBER.WHOLE_NUMBERS.COUNT_FORWARD_100",
   "key_step": "The child says each number aloud, and after a 9 in the ones moves to the next ten.",
   "floor": {
    "prerequisite": "Counts forward to 50 (Grade 1).",
    "question": "What comes after 49?",
    "answer": "50"
   },
   "representations": [
    "a skipping rope count",
    "a hundred chart",
    "a number line to 100"
   ],
   "steps": [
    "Start at the number.",
    "Say the next one.",
    "After 9 ones: next ten.",
    "Keep going."
   ],
   "contexts": [
    "counting learners in a line",
    "rope skipping",
    "counting mangoes in a basket"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write 27, 28, 29, __."
    },
    {
     "beat": "point",
     "do": "Point at the ones digit 9.",
     "say": "What comes next?"
    },
    {
     "beat": "pause",
     "do": "Wait for: 30."
    },
    {
     "beat": "reveal",
     "do": "Write 30."
    }
