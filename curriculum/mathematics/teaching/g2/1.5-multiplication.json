{
 "sub_strand": "MATH.G2.NUMBER.MULTIPLICATION",
 "title": "Multiplication",
 "status": "draft: written 18 Nov 2026 offline for Grade 2; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Outcomes a to d are KICD's words; the text layer lost the x sign in b. e is attitudinal. Repeated addition uses 1, 2 and 3 groups of 2 and 3; facts are 1-digit numbers times 1 to 5 and times 10.",
 "skills": [
  {
   "skill": "MATH.G2.NUMBER.MULTIPLICATION.MULT_REPEATED_ADD",
   "key_step": "The child makes equal groups and adds the group size once for each group.",
   "floor": {
    "prerequisite": "Adds three single digits (Grade 1).",
    "question": "2 + 2 + 2",
    "answer": "6"
   },
   "representations": [
    "counters on plates",
    "drawn rings",
    "an addition sentence"
   ],
   "steps": [
    "Make equal groups.",
    "Count the groups.",
    "Add the size each time.",
    "Say the total."
   ],
   "contexts": [
    "mandazi on plates",
    "shoes in pairs",
    "hens in a coop"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw 3 plates with 2 dots each."
    },
    {
     "beat": "point",
     "do": "Point at the plates.",
     "say": "How many groups?"
    },
    {
     "beat": "count",
     "do": "Count the dots in twos with the child."
    },
    {
     "beat": "pause",
     "do": "Wait for 6."
    },
    {
     "beat": "reveal",
     "do": "Write 2 + 2 + 2 = 6."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G2.NUMBER.MULTIPLICATION.MULT_REPEATED_ADD.M_MRA_ADDS_GROUPS_AND_SIZE",
     "listen_for": [
      "5"
     ],
     "ask": "Is it 3 + 2, or 2 three times?",
     "repair": "2 + 2 + 2 = 6."
    },
    {
     "code": "MATH.G2.NUMBER.MULTIPLICATION.MULT_REPEATED_ADD.M_MRA_COUNTS_GROUPS",
     "listen_for": [
      "2"
     ],
     "ask": "Are we counting groups or counters?",
     "repair": "Counters: 6."
    },
    {
     "code": "MATH.G2.NUMBER.MULTIPLICATION.MULT_REPEATED_ADD.M_MRA_UNEQUAL",
     "listen_for": [
      "2, 3, 1"
     ],
     "ask": "Is each group 2?",
     "repair": "Make each 2: 2, 2, 2."
    },
    {
     "code": "MATH.G2.NUMBER.MULTIPLICATION.MULT_REPEATED_ADD.M_MRA_ONE_GROUP_SHORT",
     "listen_for": [
      "3 + 3 = 6"
     ],
     "ask": "How many threes did you write?",
     "repair": "Three: 9."
    }
   ],
   "checks": [
    {
     "question": "2 groups of 3: how many?",
     "answer": "6",
     "shows": "repeated addition"
    },
    {
     "question": "Write 3 groups of 2 as an addition.",
     "answer": "2 + 2 + 2",
     "shows": "writing"
    }
   ]
  },
  {
