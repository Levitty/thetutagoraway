{
 "sub_strand": "MATH.G2.MEASUR.TIME",
 "title": "Time",
 "status": "draft: written 18 Nov 2026 offline for Grade 2; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Outcomes a to g are KICD's words; h is attitudinal. Months and special occasions, days in each month, reading the calendar, measuring time with arbitrary units (a shadow), the clock hands, and time by the hour on analogue and digital clocks.",
 "skills": [
  {
   "skill": "MATH.G2.MEASUR.TIME.MONTHS_OCCASIONS",
   "key_step": "The child says the months in order and finds an occasion's month on the class calendar.",
   "floor": {
    "prerequisite": "Months of the year (Grade 1).",
    "question": "Name the first month of the year.",
    "answer": "January"
   },
   "representations": [
    "a months song",
    "a class calendar with occasions",
    "month cards to order"
   ],
   "steps": [
    "Sing the months.",
    "Find the occasion on the calendar.",
    "Name its month.",
    "Say the month before and after."
   ],
   "contexts": [
    "Christmas",
    "Madaraka Day",
    "school opening in January"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write the months in order with a gap after January."
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "Which month?"
    },
    {
     "beat": "pause",
     "do": "Wait for February."
    },
    {
     "beat": "reveal",
     "do": "Write February."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G2.MEASUR.TIME.MONTHS_OCCASIONS.M_MO_ORDER",
     "listen_for": [
      "March"
     ],
     "ask": "What comes straight after January in the song?",
     "repair": "February."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.MONTHS_OCCASIONS.M_MO_OCCASION_WRONG_MONTH",
     "listen_for": [
      "January"
     ],
     "ask": "Is Christmas before or after the new year?",
     "repair": "Before: December."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.MONTHS_OCCASIONS.M_MO_DAY_MONTH_MIX",
     "listen_for": [
      "Monday"
     ],
     "ask": "Is Monday a day or a month?",
     "repair": "A day: May is a month."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.MONTHS_OCCASIONS.M_MO_BEFORE_AFTER",
     "listen_for": [
      "July"
     ],
     "ask": "Which side is before?",
     "repair": "Left: May."
    }
   ],
   "checks": [
    {
     "question": "Which month comes after August?",
     "answer": "September",
     "shows": "order"
    },
    {
     "question": "In which month is Jamhuri Day?",
     "answer": "December",
     "shows": "occasion"
    }
   ]
  },
  {
   "skill": "MATH.G2.MEASUR.TIME.DAYS_IN_MONTHS",
   "key_step": "The child uses the knuckles: a knuckle month has 31 days, a gap month 30, February 28 or 29.",
   "floor": {
    "prerequisite": "Knows the months in order.",
    "question": "Which month comes after March?",
    "answer": "April"
   },
   "representations": [
    "knuckles of two fists",
    "a rhyme",
    "a calendar"
   ],
   "steps": [
    "Make two fists.",
    "Name months on knuckles and gaps.",
    "Knuckle 31, gap 30.",
    "February 28 or 29."
   ],
   "contexts": [
    "a birthday month",
    "the school term",
    "a calendar at home"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw two fists with knuckles and gaps."
    },
    {
     "beat": "point",
     "do": "Point at the first knuckle: January.",
     "say": "How many days?"
    },
    {
     "beat": "count",
     "do": "Name the months along the knuckles with the child."
    },
    {
     "beat": "pause",
     "do": "Wait for April on a gap."
    },
    {
     "beat": "reveal",
     "do": "Write April 30."
    }
   ],
   "misconceptions": [
    {
