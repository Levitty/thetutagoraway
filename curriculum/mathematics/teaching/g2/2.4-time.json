  {
   "skill": "MATH.G2.MEASUR.TIME.ARBITRARY_TIME",
   "key_step": "The child uses a steady unit (claps) to compare how long things take, and the length of a shadow for the time of day.",
   "floor": {
    "prerequisite": "Relates days to activities.",
    "question": "What do we do on Sunday?",
    "answer": "go to church or rest"
   },
   "representations": [
    "steady claps",
    "a stick and its shadow",
    "a table of counts"
   ],
   "steps": [
    "Choose a steady unit.",
    "Count while the activity happens.",
    "More counts, longer.",
    "Short shadow: midday."
   ],
   "contexts": [
    "walking to the gate",
    "a tree's shadow",
    "filling a bucket"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a stick with shadows at 8, 12 and 4."
    },
    {
     "beat": "point",
     "do": "Point at the shortest shadow.",
     "say": "When was it?"
    },
    {
     "beat": "pause",
     "do": "Wait for midday."
    },
    {
     "beat": "reveal",
     "do": "Write: midday, shortest."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G2.MEASUR.TIME.ARBITRARY_TIME.M_AT_MORE_CLAPS_SHORTER",
     "listen_for": [
      "the tree"
     ],
     "ask": "Which needed more claps?",
     "repair": "The gate: longer."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.ARBITRARY_TIME.M_AT_SHADOW_NOON_LONG",
     "listen_for": [
      "in the morning"
     ],
     "ask": "When was the mark shortest?",
     "repair": "Midday."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.ARBITRARY_TIME.M_AT_UNEVEN_COUNT",
     "listen_for": [
      "yes"
     ],
     "ask": "Were the claps the same speed?",
     "repair": "No: we cannot compare."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.ARBITRARY_TIME.M_AT_SHADOW_POINTS_SUN",
     "listen_for": [
      "east"
     ],
     "ask": "Where is the sun and where is the shadow?",
     "repair": "Opposite: west."
    }
   ],
   "checks": [
