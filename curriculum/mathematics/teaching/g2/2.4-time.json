     "listen_for": [
      "30"
     ],
     "ask": "Is January on a knuckle?",
     "repair": "Yes: 31."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.DAYS_IN_MONTHS.M_DM_FEB_30",
     "listen_for": [
      "30"
     ],
     "ask": "Which month is shortest?",
     "repair": "February: 28 or 29."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.DAYS_IN_MONTHS.M_DM_KNUCKLE_SLIP",
     "listen_for": [
      "30"
     ],
     "ask": "Where does August go?",
     "repair": "On a knuckle: 31."
    },
    {
     "code": "MATH.G2.MEASUR.TIME.DAYS_IN_MONTHS.M_DM_WEEKS_FOR_DAYS",
     "listen_for": [
      "4"
     ],
     "ask": "What is the last date in April?",
     "repair": "30."
    }
   ],
   "checks": [
    {
     "question": "How many days in June?",
     "answer": "30",
     "shows": "gap month"
    },
    {
     "question": "How many days in December?",
     "answer": "31",
     "shows": "knuckle month"
    }
   ]
