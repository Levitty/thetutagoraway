 "status": "draft: written 18 Nov 2026 offline for Grade 2; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Outcomes a to c are KICD's words; d is attitudinal. Capacity is measured by filling with small containers of equal capacity, then with 1-litre containers.",
 "skills": [
  {
   "skill": "MATH.G2.MEASUR.CAPACITY.MEASURE_FIXED_CAPACITY",
   "key_step": "The child fills with the same cup each time, to the top, and counts full cups.",
   "floor": {
    "prerequisite": "Compares more and less (Grade 1).",
    "question": "Which holds more: a cup or a bucket?",
    "answer": "a bucket"
   },
   "representations": [
    "water and one cup",
    "containers of different shapes",
    "a record table"
   ],
   "steps": [
    "Choose one cup.",
    "Fill to the top.",
    "Pour; count.",
    "Compare counts."
   ],
   "contexts": [
    "filling a jerrycan",
    "a basin for washing",
    "a kettle"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a tall bottle and a wide bowl."
    },
    {
     "beat": "predict",
     "do": "The child says which holds more."
    },
    {
     "beat": "count",
     "do": "Count cups for each with the child."
    },
    {
     "beat": "reveal",
     "do": "Write 6 cups each: the same."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G2.MEASUR.CAPACITY.MEASURE_FIXED_CAPACITY.M_FC_TALL_MORE",
     "listen_for": [
      "the tall bottle"
     ],
     "ask": "How many cups did each take?",
     "repair": "6 each: the same."
    },
    {
     "code": "MATH.G2.MEASUR.CAPACITY.MEASURE_FIXED_CAPACITY.M_FC_PART_CUP",
     "listen_for": [
      "5"
     ],
     "ask": "Was the last cup full?",
     "repair": "No."
    },
    {
     "code": "MATH.G2.MEASUR.CAPACITY.MEASURE_FIXED_CAPACITY.M_FC_BIGGER_CUP_MORE",
     "listen_for": [
      "more"
     ],
     "ask": "Which needs fewer?",
     "repair": "The big mug."
    },
    {
     "code": "MATH.G2.MEASUR.CAPACITY.MEASURE_FIXED_CAPACITY.M_FC_MIXED_CUPS",
     "listen_for": [
      "yes"
     ],
     "ask": "Are the cups the same?",
     "repair": "No."
    }
   ],
   "checks": [
    {
     "question": "A jug takes 7 cups. With a bigger cup, more or fewer?",
     "answer": "fewer",
     "shows": "unit size"
    },
    {
     "question": "Two different shapes take 5 cups each. Which holds more?",
     "answer": "the same",
     "shows": "shape"
    }
   ]
