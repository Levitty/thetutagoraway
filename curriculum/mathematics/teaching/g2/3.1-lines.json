   "skill": "MATH.G2.GEOMET.LINES.STRAIGHT_LINES",
   "key_step": "The child checks a line with a ruler edge: if it does not bend anywhere it is straight, whichever way it points.",
   "floor": {
    "prerequisite": "Straight lines (Grade 1).",
    "question": "Is the edge of a ruler straight?",
    "answer": "yes"
   },
   "representations": [
    "sticks and stretched string",
    "a ruler",
    "pictures"
   ],
   "steps": [
    "Look along the line.",
    "Lay a ruler on it.",
    "No bending: straight.",
    "Draw with a firm ruler."
   ],
   "contexts": [
    "the edge of a door",
    "a flag pole",
    "a desk edge"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw an upright, a flat and a slanting line."
    },
    {
     "beat": "point",
     "do": "Point at the slanting line.",
     "say": "Is it straight?"
    },
    {
     "beat": "pause",
     "do": "Wait for yes."
    },
    {
     "beat": "child_draws",
     "do": "The child draws a slanting line with a ruler."
    },
    {
     "beat": "reveal",
     "do": "Write: all straight."
    }
   ],
