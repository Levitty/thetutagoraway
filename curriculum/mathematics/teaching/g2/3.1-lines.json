    {
     "code": "MATH.G2.GEOMET.LINES.STRAIGHT_LINES.M_SL_BROKEN_IS_CURVED",
     "listen_for": [
      "curved"
     ],
     "ask": "Does any part bend smoothly?",
     "repair": "No: straight parts."
    },
    {
     "code": "MATH.G2.GEOMET.LINES.STRAIGHT_LINES.M_SL_RULER_SLIPS",
