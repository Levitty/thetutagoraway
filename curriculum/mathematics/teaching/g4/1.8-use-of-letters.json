    {
     "code": "MATH.G4.NUMBER.USE_OF_LETTERS.LETTERS_REPRESENT.M_LET_LETTER_IS_OBJECT",
     "listen_for": [
      "3 bananas"
     ],
     "ask": "Is b the bananas or the number of bananas?",
     "repair": "The number: 3 x b."
    },
    {
     "code": "MATH.G4.NUMBER.USE_OF_LETTERS.LETTERS_REPRESENT.M_LET_DIFFERENT_LETTERS_DIFFERENT_NUMBERS",
     "listen_for": [
      "must be different"
     ],
     "ask": "Can two letters stand for the same number?",
     "repair": "Yes: y + y = 8."
    },
    {
     "code": "MATH.G4.NUMBER.USE_OF_LETTERS.LETTERS_REPRESENT.M_LET_LETTER_IGNORED",
     "listen_for": [
      "4"
     ],
     "ask": "What number does n stand for?",
     "repair": "6: 6 + 4 = 10."
    },
    {
     "code": "MATH.G4.NUMBER.USE_OF_LETTERS.LETTERS_REPRESENT.M_LET_JOINED_AS_DIGITS",
     "listen_for": [
      "320"
     ],
     "ask": "Is 3p three hundred and twenty?",
     "repair": "No: 3 x 20 = 60."
    },
    {
     "code": "MATH.G4.NUMBER.USE_OF_LETTERS.LETTERS_REPRESENT.M_LET_COEFFICIENT_ADDED",
     "listen_for": [
      "23"
     ],
     "ask": "Add or multiply?",
     "repair": "Multiply: 60."
    }
   ],
   "checks": [
