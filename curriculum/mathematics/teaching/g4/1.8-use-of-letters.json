 "notes": "Outcomes a to c are KICD's words (verified); d is attitudinal and is not mapped. HOREB filed this sub-strand under Algebra; KICD files it under Numbers. Expressions have one letter and simple addition and subtraction only, for example 3m + 2m.",
 "skills": [
  {
   "skill": "MATH.G4.NUMBER.USE_OF_LETTERS.LETTERS_REPRESENT",
   "key_step": "The child reads a letter as a number not yet known, puts its value in place of the letter, and reads 3p as 3 times p.",
   "floor": {
    "prerequisite": "Missing numbers in a box (Grade 3).",
    "question": "□ + 4 = 10. What is in the box?",
    "answer": "6"
   },
   "representations": [
    "a box with a letter on it",
    "price tags with letters",
    "a table of values"
   ],
   "steps": [
    "The letter stands for a number.",
    "Put the value in place of the letter.",
    "3p means 3 x p.",
    "Work it out."
   ],
   "contexts": [
    "the price of a pencil at the school shop",
    "the number of mangoes in a bag",
    "the age of a sister"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write p = 20 and 3p."
    },
    {
     "beat": "point",
     "do": "Point at 3p.",
     "say": "What does 3p mean?"
    },
    {
     "beat": "pause",
     "do": "Wait for 3 times p."
    },
    {
     "beat": "reveal",
     "do": "Write 3 x 20 = 60."
    }
   ],
   "misconceptions": [
