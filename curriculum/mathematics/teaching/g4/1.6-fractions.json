 "sources": [],
 "notes": "Outcomes a to e are KICD's words (verified); f is digital use and g is attitude and neither is mapped. Outcome b is split into two skills (part of a whole and part of a group). The denominator is at most 12 as outcome b says. Fractions are shown as part of a whole or group; no adding or comparing at this grade.",
 "skills": [
  {
   "skill": "MATH.G4.NUMBER.FRACTIONS.NUM_DEN",
   "key_step": "The child says the denominator counts the equal parts the whole is cut into and the numerator counts the parts taken.",
   "floor": {
    "prerequisite": "Halves, quarters and eighths of a whole (Grade 3).",
    "question": "A chapati is cut into 4 equal parts. What is one part called?",
    "answer": "a quarter"
   },
   "representations": [
    "paper strips folded into equal parts",
    "a chapati cut into pieces",
    "fraction cards"
   ],
   "steps": [
    "Check the parts are equal.",
    "Count all the equal parts: the denominator.",
    "Count the parts taken: the numerator.",
    "Write numerator over denominator."
   ],
   "contexts": [
    "a chapati shared at supper",
    "an orange cut into pieces",
    "a bar of soap"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a strip in 8 equal parts; shade 3."
    },
    {
     "beat": "point",
     "do": "Point at all the parts.",
     "say": "How many equal parts in all?"
    },
    {
     "beat": "pause",
     "do": "Wait for 8."
    },
    {
     "beat": "reveal",
     "do": "Write 3/8 and label: 3 numerator, 8 denominator."
    }
   ],
   "misconceptions": [
