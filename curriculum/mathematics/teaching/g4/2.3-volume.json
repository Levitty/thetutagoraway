   "skill": "MATH.G4.MEASUR.VOLUME.STACK_CUBES",
   "key_step": "The child piles blocks into cubes and cuboids with flat faces and counts every block, including the hidden ones, layer by layer.",
   "floor": {
    "prerequisite": "Counts objects.",
    "question": "Count the blocks in a row of 6.",
    "answer": "6"
   },
   "representations": [
    "real blocks or matchboxes",
    "a picture of layers",
    "a pile drawn layer by layer"
   ],
   "steps": [
    "Pile the blocks in flat layers.",
    "Count the blocks in one layer.",
    "Count the layers.",
    "Count the hidden blocks too."
   ],
   "contexts": [
    "bricks at a building site",
    "boxes in a shop store",
    "matchboxes on a desk"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw 2 layers of 3 by 2 blocks."
    },
    {
     "beat": "point",
     "do": "Point at the top layer.",
     "say": "How many blocks in this layer?"
    },
    {
     "beat": "pause",
     "do": "Wait for 6."
    },
    {
     "beat": "predict",
     "do": "Ask: is there a layer under it we cannot see?"
    },
    {
     "beat": "reveal",
     "do": "Write 6 + 6 = 12 blocks."
    }
   ],
