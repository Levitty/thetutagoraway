 "notes": "Outcomes a to d are KICD's words (verified); e is attitudinal. Kilograms, half and quarter kilograms; grams are not in Grade 4. HOREB's skill title said 'Units and Conversion', which is not in the design for this grade. Hands-on weighing with a beam balance is done in class.",
 "skills": [
  {
   "skill": "MATH.G4.MEASUR.MASS.KG_MEASURE",
   "key_step": "The child balances objects against kilogram masses and reads the pointer on a scale, not its end, knowing size does not tell mass.",
   "floor": {
    "prerequisite": "Measures mass in kilograms (Grade 3).",
    "question": "Which unit for a bag of maize flour?",
    "answer": "kilograms"
   },
   "representations": [
    "a beam balance with 1 kg masses",
    "a spring scale",
    "real objects"
   ],
   "steps": [
    "Put the object on one pan.",
    "Add kilogram masses to the other until they balance.",
    "Count the masses.",
    "On a scale, read where the pointer stops."
   ],
   "contexts": [
    "a bag of sugar at the shop",
    "a cabbage at the market",
    "a sack of potatoes"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a balance: a cabbage on one pan, two 1 kg masses on the other, level."
    },
    {
     "beat": "point",
     "do": "Point at the level beam.",
     "say": "What is the mass of the cabbage?"
    },
    {
     "beat": "pause",
     "do": "Wait for 2 kg."
    },
    {
     "beat": "reveal",
     "do": "Write cabbage = 2 kg."
    }
   ],
