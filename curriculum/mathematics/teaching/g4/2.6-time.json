{
 "sub_strand": "MATH.G4.MEASUR.TIME",
 "title": "Time",
 "status": "draft: written 18 Nov 2026 offline for Grade 4; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Outcomes a to f are KICD's words (verified); g attitudinal. Outcome c has three kinds of conversion (hours and minutes, hours and days, days and weeks), split into two skills. Time durations are in hours and minutes. Outcome f also covers an electronic clock, and a digital clock reading is a skill of its own.",
 "skills": [
  {
   "skill": "MATH.G4.MEASUR.TIME.TELL_TIME_AM_PM",
   "key_step": "The child reads the hour from the short hand, the minutes from the long hand counting in fives, and says a.m. before noon and p.m. after.",
   "floor": {
    "prerequisite": "Reads time past and to the hour (Grade 3).",
    "question": "The long hand is on 6 and the short hand is past 2. What time?",
    "answer": "half past 2"
   },
   "representations": [
    "a clock face with movable hands",
    "a day line from midnight to midnight",
    "a digital clock"
   ],
   "steps": [
    "Read the short hand: the hour it has passed.",
    "Count the long hand in fives.",
    "Past the hour or to the next hour.",
    "Before noon a.m., after noon p.m."
   ],
   "contexts": [
    "school assembly time",
    "a matatu leaving the stage",
    "a church service"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a clock: short hand just before 5, long hand on 9."
    },
    {
     "beat": "point",
     "do": "Point at the short hand.",
     "say": "Which number has it passed?"
    },
    {
     "beat": "pause",
     "do": "Wait for 4."
    },
    {
     "beat": "count",
     "do": "Count the long hand in fives with the child: 45."
    },
    {
     "beat": "reveal",
     "do": "Write 4:45, quarter to 5."
    }
   ],
