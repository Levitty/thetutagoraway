  {
   "skill": "MATH.G4.NUMBER.DIVISION.MULT_DIV_RELATE",
   "key_step": "The child sees one array as a multiplication and two divisions, and uses multiplying to check or find a missing number.",
   "floor": {
    "prerequisite": "Times tables.",
    "question": "7 x 8",
    "answer": "56"
   },
   "representations": [
    "an array of counters",
    "a fact family triangle",
    "egg trays"
   ],
   "steps": [
    "Write the multiplication fact.",
    "Read the array by rows: one division.",
    "Read it by columns: the other division.",
    "Check a division by multiplying."
   ],
   "contexts": [
    "eggs in trays",
    "learners in rows at assembly",
    "books shared equally"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw an array of 6 rows of 7."
    },
    {
     "beat": "point",
     "do": "Point at the rows.",
     "say": "How many in each row?"
    },
    {
     "beat": "pause",
     "do": "Wait for 7."
    },
    {
     "beat": "child_draws",
     "do": "The child writes the two division facts."
    },
    {
     "beat": "reveal",
     "do": "Write 6 x 7 = 42, 42 ÷ 7 = 6, 42 ÷ 6 = 7."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G4.NUMBER.DIVISION.MULT_DIV_RELATE.M_RELATE_WRONG_FACT",
