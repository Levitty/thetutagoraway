     "ask": "What undoes dividing?",
     "repair": "Multiplying: 8 x 7."
    },
    {
     "code": "MATH.G4.NUMBER.DIVISION.MULT_DIV_RELATE.M_RELATE_MISSING_ADDS",
     "listen_for": [
      "48"
     ],
     "ask": "Is it times or take away?",
     "repair": "Times: 54 ÷ 6 = 9."
    },
    {
     "code": "MATH.G4.NUMBER.DIVISION.MULT_DIV_RELATE.M_RELATE_ONE_DIVISION_ONLY",
     "listen_for": [
      "only one"
     ],
     "ask": "Turn the array round. What do you see?",
     "repair": "7 rows of 6: 42 ÷ 6 = 7."
    }
   ],
