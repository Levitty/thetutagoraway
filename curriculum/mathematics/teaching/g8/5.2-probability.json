     "question": "Which happens by chance: the next car at the gate is white, or Monday comes after Sunday?",
     "answer": "the next car is white",
     "shows": "chance"
    },
    {
     "question": "Picking a red ball from a bag of only red balls is?",
     "answer": "certain",
     "shows": "likelihood"
    }
   ]
  },
  {
