{
 "sub_strand": "MATH.G8.DATA_H.PROBABILITY",
 "title": "Probability",
 "status": "draft: written 18 Nov 2026 offline for Grade 8; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Official outcomes a to e and g are tested; f (use IT) is not a question. Grade 8 probability is experimental: the result of a chance experiment (tossing a coin or a bottle top, rolling a die, drawing coloured balls) written as a fraction, a decimal or a percentage, and used to estimate how often an outcome will happen in more trials. Outcomes a and g (identify and recognise chance events) share one skill. The families' old letter b covered experiments, experimental probability and expected results; they are refiled under b and c. One family multiplies along the branches of a tree diagram (combined events); this goes beyond the Grade 8 design and is filed under d for now, for a teacher to confirm or move. Writing a probability as a fraction in its simplest form (d) has no family of its own.",
 "skills": [
  {
   "skill": "MATH.G8.DATA_H.PROBABILITY.CHANCE_EVENTS",
   "key_step": "The child asks \"can anyone be sure what will happen?\" and places the event on the line from impossible to certain.",
   "floor": {
    "prerequisite": "Uses likely and unlikely.",
    "question": "Will the sun rise tomorrow?",
    "answer": "certain"
   },
   "representations": [
    "real events in a list",
    "a probability line from impossible to certain",
    "events placed on the line"
   ],
   "steps": [
    "Read the event.",
    "Can the result be known for sure?",
    "If not, it is chance.",
    "Place it on the line."
   ],
   "contexts": [
    "a raffle at a harambee",
    "tossing a coin to start a football match",
    "the weather in Kericho"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a line from impossible to certain."
    },
    {
     "beat": "point",
     "do": "Point at the middle.",
     "say": "Which event goes here: a coin landing heads?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to say."
    },
    {
     "beat": "child_draws",
     "do": "The child places three more events on the line."
    }
   ],
   "misconceptions": [
    {
