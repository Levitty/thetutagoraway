 "sources": [],
 "notes": "Official outcomes a to c are tested; d (use IT) and e (enjoy) are not questions. Tables are the printed four-figure tables of squares and square roots (numbers from 1 to 10, and for roots from 10 to 100 as well); a number outside the table is written as a table number times a power of 10 (squares) or of 100 (roots). The calculator skills (c) are about reading and rounding what the calculator shows, and knowing a sensible size for the answer. Teacher to confirm: whether learners still use printed tables in class or only the calculator.",
 "skills": [
  {
   "skill": "MATH.G8.NUMBER.SQUARES_AND_SQUARE_ROOTS.SQUARE_FROM_TABLE",
   "key_step": "The child writes the number as a table number times a power of 10 and squares that power too.",
   "floor": {
    "prerequisite": "Squares a decimal.",
    "question": "0.3²",
    "answer": "0.09"
   },
   "representations": [
    "a page of the square table",
    "the number split as 4.36 × 10",
    "the scaled answer"
   ],
   "steps": [
    "Write the number as a table number times 10, 100 or 0.1.",
    "Read the table number's square.",
    "Square the power of 10 too.",
    "Multiply and check the size."
   ],
   "contexts": [
    "a printed four-figure table",
    "squares in a land survey",
    "a square water tank base"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write 43.6 = 4.36 × 10."
    },
    {
     "beat": "point",
     "do": "Point at the × 10.",
     "say": "If each side is 10 times longer, how many times bigger is the square?"
    },
    {
     "beat": "predict",
     "do": "Wait for the child to predict."
    },
    {
     "beat": "reveal",
     "do": "Write 43.6² = 19.01 × 100 = 1,901."
    }
   ],
