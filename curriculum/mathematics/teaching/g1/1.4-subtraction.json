{
 "sub_strand": "MATH.G1.NUMBER.SUBTRACTION",
 "title": "Subtraction",
 "status": "draft: written 18 Nov 2026 offline for Grade 1; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Outcomes a to e are KICD's words; f (games) is covered with subtracting single digits. Subtraction is modelled as taking away with objects; a 1-digit number is taken from a 2-digit number with no regrouping.",
 "skills": [
  {
   "skill": "MATH.G1.NUMBER.SUBTRACTION.MODEL_SUBTRACTION",
   "key_step": "The child takes the objects away (or crosses them out) and counts what is left.",
   "floor": {
    "prerequisite": "Took some away from small groups (PP2).",
    "question": "5 stones, take 1 away: how many?",
    "answer": "4"
   },
   "representations": [
    "real objects",
    "drawings to cross out",
    "a number line"
   ],
   "steps": [
    "Show all.",
    "Take some away.",
    "Count what is left.",
    "Say how many are left."
   ],
   "contexts": [
    "sweets given away",
    "birds flying off",
    "mandazi eaten"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw 9 sweets."
    },
    {
     "beat": "child_draws",
     "do": "The child crosses out 3."
    },
    {
     "beat": "count",
     "do": "Count those left with the child."
    },
    {
     "beat": "pause",
     "do": "Wait for 6."
    },
    {
     "beat": "reveal",
     "do": "Write 6 left."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G1.NUMBER.SUBTRACTION.MODEL_SUBTRACTION.M_SUB1_COUNTS_START",
     "listen_for": [
      "7"
     ],
     "ask": "Is 9 the first step back?",
     "repair": "No: 6."
    },
    {
     "code": "MATH.G1.NUMBER.SUBTRACTION.MODEL_SUBTRACTION.M_SUB1_ADDS",
     "listen_for": [
      "12"
     ],
     "ask": "More or fewer left?",
     "repair": "Fewer: 6."
    },
    {
     "code": "MATH.G1.NUMBER.SUBTRACTION.MODEL_SUBTRACTION.M_SUB1_GIVES_TAKEN",
     "listen_for": [
      "3"
     ],
     "ask": "Is 3 what she gave or what is left?",
     "repair": "Gave: 5 are left."
    },
    {
     "code": "MATH.G1.NUMBER.SUBTRACTION.MODEL_SUBTRACTION.M_SUB1_TAKES_WRONG_NUMBER",
     "listen_for": [
      "5"
     ],
     "ask": "How many did you take?",
     "repair": "4: 6 are left."
    }
   ],
   "checks": [
    {
     "question": "10 mangoes, 4 eaten. How many left?",
     "answer": "6",
     "shows": "taking away"
    },
    {
     "question": "7 children, 2 go home. How many stay?",
     "answer": "5",
     "shows": "story"
    }
   ]
