  {
   "skill": "MATH.G1.MEASUR.TIME.DAYS_OF_WEEK",
   "key_step": "The child says the days in order like a circle and counts on from tomorrow, not today.",
   "floor": {
    "prerequisite": "Uses today and tomorrow (PP2).",
    "question": "What do we call the day after today?",
    "answer": "tomorrow"
   },
   "representations": [
    "a days song",
    "a week chart",
    "day cards in a circle"
   ],
   "steps": [
    "Sing the days.",
    "Find today.",
    "Count on from tomorrow.",
    "After Sunday comes Monday."
   ],
   "contexts": [
    "school days",
    "market day",
    "the weekend"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a circle of the seven days."
    },
    {
     "beat": "point",
     "do": "Point at Monday.",
     "say": "Two days later?"
    },
    {
     "beat": "count",
     "do": "Count on with the child: Tuesday 1, Wednesday 2."
    },
    {
     "beat": "pause",
     "do": "Wait for Wednesday."
    },
    {
     "beat": "reveal",
     "do": "Write Wednesday."
    }
   ],
