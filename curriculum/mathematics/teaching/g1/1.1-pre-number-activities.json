    "answer": "a goat"
   },
   "representations": [
    "real objects",
    "picture strips",
    "a line on the floor"
   ],
   "steps": [
    "Line them up.",
    "Find the smallest.",
    "From the rest, the smallest again.",
    "Check first to last."
   ],
   "contexts": [
    "children by height",
    "fruits at the market",
    "sticks"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a grape, a pumpkin and a mango."
    },
    {
     "beat": "predict",
     "do": "The child says which is smallest."
    },
    {
     "beat": "pause",
     "do": "Wait for the grape."
    },
    {
     "beat": "reveal",
     "do": "Write 1, 2, 3 under grape, mango, pumpkin."
    }
   ],
   "misconceptions": [
    {
