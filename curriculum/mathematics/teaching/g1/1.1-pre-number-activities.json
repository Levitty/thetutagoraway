 "sources": [],
 "notes": "Outcomes a to d are KICD's words; e is attitudinal. Sorting, matching, ordering and patterning with real objects collected from the environment; prerequisites below Grade 1 are pre-primary readiness skills HOREB names (scripts/data/maths-g1/readiness.mjs).",
 "skills": [
  {
   "skill": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.SORT_OBJECTS",
   "key_step": "The child says one rule and checks every object against it.",
   "floor": {
    "prerequisite": "Sorted by one attribute (PP2).",
    "question": "Put the red bottle tops together.",
    "answer": "the red ones"
   },
   "representations": [
    "real objects",
    "picture cards",
    "sorting hoops"
   ],
   "steps": [
    "Choose one rule.",
    "Say it aloud.",
    "Check each object.",
    "Name the odd one out."
   ],
   "contexts": [
    "sorting beans and maize",
    "shoes at the door",
    "leaves in the compound"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a spoon, a fork, a cup and a stone."
    },
    {
     "beat": "point",
     "do": "Point at each.",
     "say": "What do we use it for?"
    },
    {
     "beat": "pause",
     "do": "Wait for the odd one."
    },
    {
     "beat": "reveal",
     "do": "Ring the stone."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.SORT_OBJECTS.M_SORT_TWO_RULES",
     "listen_for": [
      "the two big balls"
     ],
     "ask": "Are we sorting by colour or by size?",
     "repair": "Colour: the two red balls."
    },
    {
     "code": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.SORT_OBJECTS.M_SORT_ODD_ONE",
     "listen_for": [
      "the cup"
     ],
     "ask": "Do we eat with a stone?",
     "repair": "No: the stone does not belong."
    },
    {
     "code": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.SORT_OBJECTS.M_SORT_NO_RULE",
     "listen_for": [
      "I wanted to"
     ],
     "ask": "What is the same about them?",
     "repair": "Both are green."
    },
    {
     "code": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.SORT_OBJECTS.M_SORT_ONE_GROUP_MISSED",
     "listen_for": [
      "the ball and the orange"
     ],
     "ask": "Is the plate round?",
     "repair": "Yes: it goes in too."
    }
   ],
   "checks": [
    {
     "question": "Which does not belong: mango, banana, orange, shoe?",
     "answer": "shoe",
     "shows": "odd one out"
    },
    {
     "question": "Sort by size: big ball, small ball, big stone. Which go together?",
     "answer": "big ball and big stone",
     "shows": "rule"
    }
   ]
  },
  {
   "skill": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.MATCH_OBJECTS",
   "key_step": "The child names the shared attribute before pairing.",
