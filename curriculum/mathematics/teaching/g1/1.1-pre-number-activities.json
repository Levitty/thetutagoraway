     "listen_for": [
      "pumpkin, mango, grape"
     ],
     "ask": "Which is smallest?",
     "repair": "The grape: grape, mango, pumpkin."
    },
    {
     "code": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.ORDER_OBJECTS.M_ORD1_MIDDLE",
     "listen_for": [
      "3, 7, 5, 9"
     ],
     "ask": "Of 7, 5 and 9 which is shortest?",
     "repair": "5."
    },
    {
     "code": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.ORDER_OBJECTS.M_ORD1_NOT_ALIGNED",
     "listen_for": [
      "the one that sticks out"
     ],
     "ask": "Do they start together?",
     "repair": "Line them up, then compare."
    },
    {
     "code": "MATH.G1.NUMBER.PRE_NUMBER_ACTIVITIES.ORDER_OBJECTS.M_ORD1_SIZE_HEIGHT_MIX",
     "listen_for": [
      "feather, stone, box"
     ],
     "ask": "Is the empty box heavier than the stone?",
     "repair": "No: feather, box, stone."
    }
   ],
   "checks": [
    {
     "question": "Order from biggest: a cat, a cow, a mouse.",
     "answer": "cow, cat, mouse",
     "shows": "biggest first"
    },
    {
     "question": "Order from shortest: sticks of 5, 2 and 8 hand spans.",
     "answer": "2, 5, 8",
     "shows": "shortest first"
