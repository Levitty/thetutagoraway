   "key_step": "The child checks if a line bends: no bending is straight, smooth bending is curved.",
   "floor": {
    "prerequisite": "Drew lines and curves (PP2).",
    "question": "Draw a line.",
    "answer": "a line"
   },
   "representations": [
    "children standing in a queue",
    "objects",
    "pictures"
   ],
   "steps": [
    "Look along the line.",
    "Does it bend?",
    "No: straight.",
    "Smoothly: curved."
   ],
   "contexts": [
    "a queue at assembly",
    "the rim of a plate",
    "a rainbow"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a straight line and a curve."
    },
    {
     "beat": "point",
     "do": "Point at each.",
     "say": "Which bends?"
    },
    {
     "beat": "pause",
     "do": "Wait for the curve."
    },
    {
     "beat": "reveal",
     "do": "Label: straight, curved."
    }
   ],
