 "sources": [],
 "notes": "Outcomes a to f are KICD's words; g (games with devices or other resources) is covered with adding two single digits. Addition is modelled with objects first; sums of a 2-digit and a 1-digit number stay within 50 with no regrouping.",
 "skills": [
  {
   "skill": "MATH.G1.NUMBER.ADDITION.MODEL_ADDITION",
   "key_step": "The child puts both groups together and counts all, or holds the first number and counts on the second.",
   "floor": {
    "prerequisite": "Put small groups together (PP2).",
    "question": "2 stones and 1 more: how many?",
    "answer": "3"
   },
   "representations": [
    "real objects",
    "drawings of two groups",
    "a number line"
   ],
   "steps": [
    "Show the first group.",
    "Add the second group.",
    "Count all, or count on.",
    "Say how many now."
   ],
   "contexts": [
    "birds on a tree",
    "mangoes in a basket",
    "children joining a game"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw 6 birds and 3 more flying in."
    },
    {
     "beat": "point",
     "do": "Point at the 6.",
     "say": "Keep 6 in your head."
    },
    {
     "beat": "count",
     "do": "Count on with the child: 7, 8, 9."
    },
    {
     "beat": "pause",
     "do": "Wait for 9."
    },
    {
     "beat": "reveal",
     "do": "Write 9 birds."
    }
   ],
