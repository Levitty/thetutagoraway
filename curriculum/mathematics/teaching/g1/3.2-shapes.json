     "listen_for": [
      "no"
     ],
     "ask": "How many sides?",
     "repair": "3: a triangle."
    },
    {
     "code": "MATH.G1.GEOMET.SHAPES.IDENTIFY_SHAPES.M_SHP1_OVAL_CIRCLE",
     "listen_for": [
      "circle"
     ],
     "ask": "Is it longer one way?",
     "repair": "Yes: an oval."
    },
    {
     "code": "MATH.G1.GEOMET.SHAPES.IDENTIFY_SHAPES.M_SHP1_SIDE_COUNT",
     "listen_for": [
      "yes"
     ],
     "ask": "How many sides did you touch?",
     "repair": "4: not a triangle."
    },
    {
     "code": "MATH.G1.GEOMET.SHAPES.IDENTIFY_SHAPES.M_SHP1_OBJECT_NAME",
     "listen_for": [
      "door"
     ],
     "ask": "How many sides and corners?",
     "repair": "4: a rectangle."
    }
   ],
   "checks": [
    {
     "question": "A shape with no corners and no straight sides: what is it?",
     "answer": "a circle",
