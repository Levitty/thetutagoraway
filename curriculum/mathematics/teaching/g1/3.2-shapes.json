 "skills": [
  {
   "skill": "MATH.G1.GEOMET.SHAPES.IDENTIFY_SHAPES",
   "key_step": "The child counts the sides and corners to name the shape, whichever way it is turned.",
   "floor": {
    "prerequisite": "Named basic shapes (PP2).",
    "question": "What shape is a ball's outline?",
    "answer": "a circle"
   },
   "representations": [
    "cut-outs",
    "objects in the class",
    "pictures turned different ways"
   ],
   "steps": [
    "Count the sides.",
    "Count the corners.",
    "Straight or round?",
    "Name it."
   ],
   "contexts": [
    "a door",
    "a roof",
    "a clock"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a triangle on its point."
    },
    {
     "beat": "point",
     "do": "Point at each side.",
     "say": "How many?"
    },
    {
     "beat": "pause",
     "do": "Wait for 3."
    },
    {
     "beat": "reveal",
     "do": "Write: triangle."
    }
   ],
   "misconceptions": [
