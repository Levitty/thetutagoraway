{
 "sub_strand": "MATH.G9.DATA_H.PROBABILITY",
 "title": "Probability",
 "status": "draft: written 18 Nov 2026 offline for Grade 9; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Official outcomes a to f are tested; g (appreciate) is not a question. Experiments with equally likely outcomes (a), probability from 0 to 1 and expected numbers (b), mutually exclusive events (c) and adding their probabilities, with the complement for neither (d), independent events multiplied, with and without replacement (e), and tree diagrams for two stages (f). Grade 8 did chance, experimental probability and one two-stage tree. Experiments with equally likely outcomes (a) have no family of their own. least-likely-table builds its options in code and is tied at family level. g9.prob.raffle-either, g9.prob.way-to-school-table and g9.prob.neither-road-spot were written under c; they add the probabilities of mutually exclusive events, so they are filed under d. Teacher to confirm: KICD's f says 'a tree diagram for a single outcome'; two families use two-stage trees (as Grade 8 did), so a teacher should say whether that matches the intended depth.",
 "skills": [
  {
   "skill": "MATH.G9.DATA_H.PROBABILITY.EQUALLY_LIKELY",
   "key_step": "The child lists every outcome, checks they are equally likely, then counts favourable over all.",
   "floor": {
    "prerequisite": "Writes a probability as a fraction.",
    "question": "One red of 4 equal sectors",
    "answer": "1/4"
   },
   "representations": [
    "a list of outcomes",
    "a fair spinner and an unfair one",
    "a die"
   ],
   "steps": [
    "List all outcomes.",
    "Check they are equally likely.",
    "Count the favourable ones.",
    "Favourable over all."
   ],
   "contexts": [
    "a board game at home",
    "a spinner at a school fete",
    "tossing a coin to start a football match"
   ],
   "board": [
