     "say": "What is 8 divided by 6, and 6 divided by 4?"
    },
    {
     "beat": "pause",
     "do": "Wait for 1.33 and 1.5."
    },
    {
     "beat": "reveal",
     "do": "Write different factors: not similar."
    }
   ],
