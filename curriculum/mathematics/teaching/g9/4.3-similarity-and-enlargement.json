{
 "sub_strand": "MATH.G9.GEOMET.SIMILARITY_AND_ENLARGEME",
 "title": "Similarity and Enlargement",
 "status": "draft: written 18 Nov 2026 offline for Grade 9; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Official outcomes a to e are tested; f (promote the use) is not a question. Similar figures have equal angles and sides in one ratio (a), drawing similar figures (b), properties of enlargement, its centre and scale factor (c), drawing objects and images (d), and the linear scale factor (e), with area and volume factors as its square and cube. Five existing families use area and volume scale factors; KICD's outcome e names only the linear scale factor, so a teacher should confirm that area and volume factors belong in Grade 9. Drawing similar figures (b) and enlargements (d) have no family: a typed answer cannot check a drawing. similar-cartons-table builds its wrong answers in code and is tied at family level.",
 "skills": [
  {
   "skill": "MATH.G9.GEOMET.SIMILARITY_AND_ENLARGEME.SIMILAR_IDENTIFY",
   "key_step": "The child divides each pair of matching sides and checks they all give the same number.",
   "floor": {
    "prerequisite": "Compares ratios.",
    "question": "Is 2:3 the same as 4:6?",
    "answer": "Yes"
   },
   "representations": [
    "two rectangles side by side",
    "a table of side ratios",
    "photo enlargements"
   ],
   "steps": [
    "Match the sides.",
    "Divide each pair.",
    "Same answer each time: similar.",
    "For triangles, equal angles is enough."
   ],
   "contexts": [
    "passport photo and a large print",
    "a model of a school building",
    "Kenya flags of two sizes"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a 6 by 4 and an 8 by 6 rectangle."
    },
    {
     "beat": "point",
