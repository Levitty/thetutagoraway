  {
   "skill": "MATH.G3.NUMBER.MULTIPLICATION.MULT_REPEATED_ADDITION",
   "key_step": "The child names the number of groups and the size of each, then adds the group size that many times.",
   "floor": {
    "prerequisite": "Repeated addition by 2 and 3 (Grade 2).",
    "question": "3 + 3 + 3 is how many threes?",
    "answer": "three threes"
   },
   "representations": [
    "counters in plates",
    "drawn rings",
    "an addition line"
   ],
   "steps": [
    "Make equal groups.",
    "Count the groups.",
    "Write the size that many times.",
    "Write groups x size."
   ],
   "contexts": [
    "sweets in packets",
    "legs of cows",
    "chairs in rows"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw 3 rings with 5 dots each."
    },
    {
     "beat": "point",
     "do": "Point at the rings.",
     "say": "How many groups?"
    },
    {
     "beat": "pause",
     "do": "Wait for 3."
    },
    {
     "beat": "child_draws",
     "do": "The child writes 5 + 5 + 5."
    },
    {
     "beat": "reveal",
     "do": "Write 3 x 5 = 15."
    }
   ],
   "misconceptions": [
