     "ask": "Is it 3 + 5, or 5 three times?",
     "repair": "5 + 5 + 5 = 15."
    },
    {
     "code": "MATH.G3.NUMBER.MULTIPLICATION.MULT_REPEATED_ADDITION.M_MREP_ONE_GROUP_SHORT",
     "listen_for": [
      "4 + 4 + 4 + 4 = 16"
     ],
     "ask": "How many fours did you write?",
     "repair": "Five: 20."
    },
    {
     "code": "MATH.G3.NUMBER.MULTIPLICATION.MULT_REPEATED_ADDITION.M_MREP_UNEQUAL_GROUPS",
     "listen_for": [
      "yes"
     ],
     "ask": "Are all the groups the same size?",
     "repair": "No, so it is not 3 x 4."
    }
   ],
