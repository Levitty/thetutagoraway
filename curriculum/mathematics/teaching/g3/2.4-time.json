{
 "sub_strand": "MATH.G3.MEASUR.TIME",
 "title": "Time",
 "status": "draft: written 18 Nov 2026 offline for Grade 3; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Outcomes a to g are KICD's words; h is attitudinal. Time is read past and to the hour on analogue clocks and on digital clocks; adding and subtracting hours and minutes is without conversion (minutes never pass 60).",
 "skills": [
  {
   "skill": "MATH.G3.MEASUR.TIME.MINUTE_UNIT",
   "key_step": "The child counts the small marks: five minutes between numbers, sixty round the face.",
   "floor": {
    "prerequisite": "Knows the hour and minute hands (Grade 2).",
    "question": "Which hand is longer?",
    "answer": "the minute hand"
   },
   "representations": [
    "a clock face with movable hands",
    "a drawn face with marks",
    "a 60-mark strip"
   ],
   "steps": [
    "Find the small marks.",
    "Count them from 12 to 1: 5.",
    "Count in fives round the face.",
    "60 minutes make one hour."
   ],
   "contexts": [
    "a one-minute clap game",
    "the school bell",
    "boiling water for tea"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a clock face with minute marks."
    },
    {
     "beat": "point",
     "do": "Point from 12 to 1.",
     "say": "How many small marks?"
    },
    {
     "beat": "count",
     "do": "Count in fives with the child round the face."
    },
    {
     "beat": "pause",
     "do": "Wait for 60."
    },
    {
     "beat": "reveal",
     "do": "Write 60 minutes = 1 hour."
    }
   ],
   "misconceptions": [
