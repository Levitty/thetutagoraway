     "repair": "15: 15 minutes."
    },
    {
     "code": "MATH.G3.MEASUR.TIME.MINUTE_UNIT.M_MIN_100_IN_HOUR",
     "listen_for": [
      "100"
     ],
     "ask": "How many small marks round the face?",
     "repair": "60."
    },
    {
     "code": "MATH.G3.MEASUR.TIME.MINUTE_UNIT.M_MIN_HOUR_MIN_SAME",
     "listen_for": [
      "a school day"
     ],
     "ask": "Could you clap through a whole school day?",
     "repair": "No: a minute is short."
    },
    {
     "code": "MATH.G3.MEASUR.TIME.MINUTE_UNIT.M_MIN_FIVE_BETWEEN_NUMBERS_ONE",
     "listen_for": [
      "1"
     ],
     "ask": "How many small marks?",
     "repair": "5."
    }
   ],
   "checks": [
