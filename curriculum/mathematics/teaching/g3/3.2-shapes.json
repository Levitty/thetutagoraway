     ],
     "ask": "Which side do they share?",
     "repair": "The top of the square."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.DRAW_COMBINED.M_DRAW_WRONG_SIDES",
     "listen_for": [
      "4"
     ],
     "ask": "How many sides should a triangle have?",
     "repair": "3."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.DRAW_COMBINED.M_DRAW_CURVED_FOR_STRAIGHT",
     "listen_for": [
      "curved"
     ],
     "ask": "Should a triangle's sides be straight?",
     "repair": "Yes."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.DRAW_COMBINED.M_DRAW_THREE_SHAPES",
     "listen_for": [
      "rectangle, triangle and circle"
     ],
     "ask": "How many shapes did you draw?",
     "repair": "Two only."
    }
   ],
   "checks": [
    {
     "question": "Draw a rectangle with a triangle on top. How many shapes?",
     "answer": "2",
     "shows": "two shapes"
    },
    {
     "question": "Do the shapes share a side?",
     "answer": "yes",
     "shows": "joined"
    }
   ]
  },
  {
   "skill": "MATH.G3.GEOMET.SHAPES.MODEL_COMBINED",
