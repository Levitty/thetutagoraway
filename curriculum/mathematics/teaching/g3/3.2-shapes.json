{
 "sub_strand": "MATH.G3.GEOMET.SHAPES",
 "title": "Shapes",
 "status": "draft: written 18 Nov 2026 offline for Grade 3; not yet checked by a Kenyan maths teacher; not loaded by the live tutor",
 "sources": [],
 "notes": "Outcomes a to c are KICD's words; d is attitudinal. Combined shapes are made of two different shapes (a hut is a triangle on a rectangle). Drawing and modelling are done with paper cut-outs and local materials in class.",
 "skills": [
  {
   "skill": "MATH.G3.GEOMET.SHAPES.NAME_SHAPES",
   "key_step": "The child counts the sides and corners and checks if they are equal or curved to name the shape.",
   "floor": {
    "prerequisite": "Identifies shapes (Grade 2).",
    "question": "Which shape is round: a circle or a square?",
    "answer": "a circle"
   },
   "representations": [
    "paper cut-outs",
    "drawings in different positions",
    "objects in the room"
   ],
   "steps": [
    "Count the sides.",
    "Straight or curved?",
    "Are the sides equal?",
    "Name it, whatever its position."
   ],
   "contexts": [
    "windows and doors",
    "a road sign",
    "a wall clock"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a square turned on a corner."
    },
    {
     "beat": "point",
     "do": "Point at each side.",
     "say": "How many? Equal?"
    },
    {
     "beat": "pause",
     "do": "Wait for: 4 equal sides."
    },
    {
     "beat": "reveal",
     "do": "Write: square."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G3.GEOMET.SHAPES.NAME_SHAPES.M_SHAPE_TURNED_SQUARE",
     "listen_for": [
      "no, a diamond"
     ],
     "ask": "Did the sides change when it turned?",
     "repair": "No: still a square."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.NAME_SHAPES.M_SHAPE_OVAL_CIRCLE",
     "listen_for": [
      "circle"
     ],
     "ask": "Is it as wide as it is long?",
     "repair": "No: an oval."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.NAME_SHAPES.M_SHAPE_SQUARE_NOT_RECTANGLE",
     "listen_for": [
      "square"
     ],
     "ask": "Are all its sides equal?",
     "repair": "No: a rectangle."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.NAME_SHAPES.M_SHAPE_TRIANGLE_UPRIGHT_ONLY",
     "listen_for": [
      "no"
     ],
     "ask": "How many straight sides?",
     "repair": "3: a triangle."
    }
   ],
   "checks": [
    {
     "question": "A shape has 3 straight sides. Name it.",
     "answer": "triangle",
     "shows": "sides"
    },
    {
     "question": "An egg shape: circle or oval?",
     "answer": "oval",
     "shows": "curved shapes"
    }
   ]
  },
  {
   "skill": "MATH.G3.GEOMET.SHAPES.SHAPES_IN_COMBINED",
   "key_step": "The child finds the inside line that splits the combined shape and names each part.",
   "floor": {
    "prerequisite": "Names the basic shapes.",
    "question": "A shape has 4 equal sides. Name it.",
    "answer": "square"
   },
   "representations": [
    "a cut-out hut that comes apart",
    "drawings",
    "pictures of real buildings"
   ],
   "steps": [
    "Look for the joining line.",
    "Cover one part.",
    "Name the part left.",
    "Name the other part."
   ],
   "contexts": [
    "a hut in the village",
    "a house",
    "an ice cream cone"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a hut: triangle roof on a rectangle."
    },
    {
     "beat": "point",
     "do": "Cover the roof.",
     "say": "What shape is left?"
    },
    {
     "beat": "pause",
     "do": "Wait for: a rectangle."
    },
    {
     "beat": "reveal",
     "do": "Write: triangle and rectangle."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G3.GEOMET.SHAPES.SHAPES_IN_COMBINED.M_COMB_ONE_SHAPE",
     "listen_for": [
      "a hut"
     ],
     "ask": "What is the roof's shape?",
     "repair": "A triangle, and the walls a rectangle."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.SHAPES_IN_COMBINED.M_COMB_COUNTS_SIDES_TOTAL",
     "listen_for": [
      "a pentagon"
     ],
     "ask": "Is there a line between the roof and the walls?",
     "repair": "Yes: a triangle and a square."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.SHAPES_IN_COMBINED.M_COMB_SAME_SHAPE_TWICE",
     "listen_for": [
      "two triangles"
     ],
     "ask": "Is the top part straight or round?",
     "repair": "Round: a circle on a triangle."
    },
    {
     "code": "MATH.G3.GEOMET.SHAPES.SHAPES_IN_COMBINED.M_COMB_WRONG_PART_NAME",
     "listen_for": [
      "roof"
     ],
     "ask": "How many sides does the roof have?",
     "repair": "3: a triangle."
    }
   ],
   "checks": [
    {
     "question": "A triangle on a square: which two shapes?",
     "answer": "triangle and square",
     "shows": "parts"
    },
    {
     "question": "An ice cream cone: which two shapes?",
     "answer": "circle and triangle",
     "shows": "curved part"
    }
   ]
  },
  {
   "skill": "MATH.G3.GEOMET.SHAPES.DRAW_COMBINED",
   "key_step": "The child draws the first shape, then uses one of its sides as a side of the second.",
   "floor": {
    "prerequisite": "Draws shapes (Grade 2).",
    "question": "Draw a triangle. How many sides?",
    "answer": "3"
   },
   "representations": [
    "a ruler and pencil",
    "a model to copy",
    "a drawing on squared paper"
   ],
   "steps": [
    "Draw the bottom shape.",
    "Choose the shared side.",
    "Draw the second shape on it.",
    "Count both shapes' sides."
   ],
   "contexts": [
    "drawing a house",
    "a church with a roof",
    "a rocket"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a square."
    },
    {
     "beat": "point",
     "do": "Point at its top side.",
     "say": "The roof sits here."
    },
    {
     "beat": "child_draws",
     "do": "The child draws the triangle on the top side."
    },
    {
     "beat": "reveal",
     "do": "Label: square and triangle."
    }
   ],
   "misconceptions": [
    {
     "code": "MATH.G3.GEOMET.SHAPES.DRAW_COMBINED.M_DRAW_GAP",
     "listen_for": [
