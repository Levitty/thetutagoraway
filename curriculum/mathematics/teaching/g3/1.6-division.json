 "notes": "Outcomes a to c are KICD's words; d is attitudinal. Repeated subtraction is for numbers up to 50 by 4 and 5; division has no remainder; dividing by 10 is for multiples of ten up to 90.",
 "skills": [
  {
   "skill": "MATH.G3.NUMBER.DIVISION.DIV_REPEATED_SUBTRACTION",
   "key_step": "The child takes away the same number again and again until nothing is left and counts the takes.",
   "floor": {
    "prerequisite": "Equal grouping by 3 (Grade 2).",
    "question": "Put 12 counters in threes. How many groups?",
    "answer": "4"
   },
   "representations": [
    "counters",
    "a backwards number line",
    "a subtraction chain"
   ],
   "steps": [
    "Start with all.",
    "Take away the group size.",
    "Write what is left.",
    "Count the takes when you reach 0."
   ],
   "contexts": [
    "feeding cows maize cobs each day",
    "packing eggs",
    "sharing mangoes"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw 20 dots."
    },
    {
     "beat": "point",
     "do": "Ring 5 dots.",
     "say": "How many left?"
    },
    {
     "beat": "child_draws",
     "do": "The child rings fives until none are left."
    },
    {
     "beat": "pause",
     "do": "Wait for the number of rings."
    },
    {
     "beat": "reveal",
     "do": "Write 20 ÷ 5 = 4."
    }
   ],
   "misconceptions": [
