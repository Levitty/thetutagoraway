     "code": "MATH.G3.NUMBER.DIVISION.DIV_REPEATED_SUBTRACTION.M_DREP_ANSWER_LAST_NUMBER",
     "listen_for": [
      "0"
     ],
     "ask": "How many rings?",
     "repair": "4: 20 ÷ 5 = 4."
    },
    {
     "code": "MATH.G3.NUMBER.DIVISION.DIV_REPEATED_SUBTRACTION.M_DREP_STOPS_EARLY",
     "listen_for": [
      "3"
     ],
     "ask": "Is anything left after 3 takes?",
     "repair": "4 left, one more take: 4 times."
    },
    {
     "code": "MATH.G3.NUMBER.DIVISION.DIV_REPEATED_SUBTRACTION.M_DREP_SUBTRACTS_ONCE",
     "listen_for": [
      "35"
     ],
     "ask": "Is the store empty after one day?",
     "repair": "No: keep going, 8 days."
    },
    {
     "code": "MATH.G3.NUMBER.DIVISION.DIV_REPEATED_SUBTRACTION.M_DREP_WRONG_GROUP",
     "listen_for": [
      "20, 16"
     ],
     "ask": "What is 20 take away 5?",
     "repair": "15."
    }
   ],
   "checks": [
