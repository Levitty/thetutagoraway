   "assessed_by": "teacher",
   "key_step": "The child names the main event in the text and finds a real event in his or her life like it.",
   "floor": {
    "prerequisite": "Knows the events in a story.",
    "question": "What happened in the story?",
    "answer": "the main event"
   },
   "steps": [
    "Say the main event.",
    "Think of a time like it.",
    "Say how they are alike.",
    "Say one difference."
   ],
   "contexts": [
    "a story about table manners",
    "a leisure-time story",
    "a story about pollution"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: In the story ... In my life ..."
    },
    {
     "beat": "point",
     "do": "Point at In my life.",
     "say": "When did something like this happen to you?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child says one difference."
    }
   ],
