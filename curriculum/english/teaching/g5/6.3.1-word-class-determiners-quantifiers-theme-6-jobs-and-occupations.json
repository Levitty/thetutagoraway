   "key_step": "The child asks \"count or not?\" and \"some or almost none?\" before choosing few, a few, little or a little.",
   "floor": {
    "prerequisite": "Uses many and much.",
    "question": "How ___ water?",
    "answer": "much"
   },
   "steps": [
    "Count: few, a few.",
    "Not count: little, a little.",
    "A few = some; few = almost none."
   ],
   "contexts": [
    "jobs: a few nurses, little time"
   ],
