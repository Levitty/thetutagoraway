   "key_step": "The child puts too before the adjective and to before the plain verb, or for before the person.",
   "floor": {
    "prerequisite": "Uses adjectives.",
    "question": "The tea is ___ (hot).",
    "answer": "hot"
   },
   "steps": [
    "Too + adjective.",
    "To + plain verb.",
    "For + person."
   ],
   "contexts": [
    "table manners: food too hot to eat"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: The tea is too hot ___ drink."
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "To or for?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child writes a for sentence."
    }
   ],
