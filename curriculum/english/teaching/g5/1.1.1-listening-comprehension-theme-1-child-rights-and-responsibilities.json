  {
   "skill": "ENGL.G5.LISTEN.T1_LISTENING_COMPREHENS.LISTEN_MAIN_IDEA",
   "assessed_by": "voice",
   "key_step": "The child asks \"what was it all about?\" after listening, then adds two details.",
   "floor": {
    "prerequisite": "Recalls details from an oral text.",
    "question": "Teacher reads a sentence. Who was in it?",
    "answer": "the person named"
   },
   "steps": [
    "Say what to listen for.",
    "Listen once.",
    "Say the main idea in one sentence.",
    "Add two details; respond to any request."
   ],
   "contexts": [
    "a talk on child rights",
    "a radio item on traditional food",
    "a speech at a national day"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Main idea, Detail 1, Detail 2."
    },
    {
     "beat": "point",
     "do": "Point at Main idea.",
     "say": "What was the talk mostly about?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child fills the two details."
    }
   ],
