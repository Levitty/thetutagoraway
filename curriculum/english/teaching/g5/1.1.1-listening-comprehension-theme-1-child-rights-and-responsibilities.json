 "skills": [
  {
   "skill": "ENGL.G5.LISTEN.T1_LISTENING_COMPREHENS.THEME_WORDS",
   "assessed_by": "questions",
   "key_step": "The child says whether the word names something every child needs (a right) or something a child must do (a responsibility).",
   "floor": {
    "prerequisite": "Uses theme words.",
    "question": "What is a family?",
    "answer": "people who live together and care"
   },
   "steps": [
    "Say the word.",
    "Is it a right or a responsibility?",
    "Use it in a sentence."
   ],
   "contexts": [
    "child rights at school",
    "chores at home"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: education, sweeping, health care."
    },
    {
     "beat": "point",
     "do": "Point at sweeping.",
     "say": "Right or responsibility?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child sorts the rest."
    }
   ],
   "misconceptions": [
    {
     "code": "ENGL.G5.LISTEN.T1_LISTENING_COMPREHENS.THEME_WORDS.M_VOC_RIGHT_RESPONSIBILITY",
     "listen_for": [
      "responsibility"
     ],
     "ask": "Is it given to you or done by you?",
     "repair": "Done by you: responsibility."
    },
    {
     "code": "ENGL.G5.LISTEN.T1_LISTENING_COMPREHENS.THEME_WORDS.M_VOC_NEAR_MEANING",
     "listen_for": [
      "respect"
     ],
     "ask": "What does it mean?",
     "repair": "Match the meaning."
    },
    {
     "code": "ENGL.G5.LISTEN.T1_LISTENING_COMPREHENS.THEME_WORDS.M5_VOC_RIGHT_AS_WANT",
     "listen_for": [
      "a new phone"
     ],
     "ask": "Want or need?",
     "repair": "Rights are needs."
    },
    {
     "code": "ENGL.G5.LISTEN.T1_LISTENING_COMPREHENS.THEME_WORDS.M5_VOC_ABUSE_ANY_RULE",
     "listen_for": [
      "abuse"
     ],
     "ask": "Does it harm the child?",
     "repair": "If not, it is guidance."
    }
   ],
   "checks": [
    {
     "question": "Going to school is a ...",
     "answer": "right",
     "shows": "right"
    },
    {
     "question": "Helping at home is a ...",
     "answer": "responsibility",
     "shows": "responsibility"
    }
   ]
