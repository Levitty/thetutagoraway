    {
     "beat": "point",
     "do": "Point at County.",
     "say": "What goes here?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child fills the date box."
    }
