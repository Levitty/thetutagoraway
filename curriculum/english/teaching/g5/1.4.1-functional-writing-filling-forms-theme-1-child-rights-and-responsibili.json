   },
   "steps": [
    "Read the whole form.",
    "Read each label and format.",
    "Write the detail.",
    "Check every box."
   ],
   "contexts": [
    "a school club form",
    "a library card",
    "a health card"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Draw: Name (BLOCK LETTERS), County, Date of birth (DD/MM/YYYY)."
