     "listen_for": [
      "this"
     ],
     "ask": "One or many?",
     "repair": "These for many."
    },
    {
     "code": "ENGL.G5.GRAMMA.T1_WORD_CLASS_DEMONSTRA.DEMONSTRATIVES.M_DEM_THESE_SINGULAR",
     "listen_for": [
      "These"
     ],
     "ask": "One or many?",
     "repair": "This for one."
    },
    {
     "code": "ENGL.G5.GRAMMA.T1_WORD_CLASS_DEMONSTRA.DEMONSTRATIVES.M_DEM_NEAR_FAR",
     "listen_for": [
      "That"
     ],
     "ask": "Near or far?",
     "repair": "This is near."
    },
    {
     "code": "ENGL.G5.GRAMMA.T1_WORD_CLASS_DEMONSTRA.DEMONSTRATIVES.M_DEM_THEM",
     "listen_for": [
      "them"
     ],
     "ask": "Is them a demonstrative?",
     "repair": "Those."
    }
   ],
