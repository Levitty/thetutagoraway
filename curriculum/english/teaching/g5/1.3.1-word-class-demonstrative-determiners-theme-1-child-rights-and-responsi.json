   "assessed_by": "questions",
   "key_step": "The child asks \"one or many?\" and \"near or far?\" before choosing this, these, that or those.",
   "floor": {
    "prerequisite": "Uses a and the.",
    "question": "___ book is mine.",
    "answer": "The"
   },
   "steps": [
    "One or many?",
    "Near or far?",
    "Choose the word."
   ],
   "contexts": [
    "books on a desk",
    "children across the field"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Draw near and far boxes."
    },
    {
     "beat": "point",
     "do": "Point at the far box with many items.",
     "say": "These or those?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child labels the others."
    }
   ],
   "misconceptions": [
