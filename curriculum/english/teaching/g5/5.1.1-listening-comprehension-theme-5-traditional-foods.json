   "key_step": "The child decides the feeling first, then lets voice, face and hands match it.",
   "floor": {
    "prerequisite": "Reads feelings in others.",
    "question": "This face is ...",
    "answer": "happy"
   },
   "steps": [
    "Decide the feeling.",
    "Choose a voice for it.",
    "Add a fitting gesture.",
    "As a listener, face the speaker and nod."
   ],
   "contexts": [
    "telling a traditional food story",
    "reciting a poem on technology",
    "a talk on a disease"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: happy, worried, proud."
    },
    {
     "beat": "point",
     "do": "Point at worried.",
     "say": "Say \"The rain has not come\" in a worried voice."
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child says it in a proud voice."
    }
   ],
