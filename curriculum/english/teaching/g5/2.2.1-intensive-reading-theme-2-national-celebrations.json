     "ask": "Did you copy a line?",
     "repair": "Say what it shows."
    },
    {
     "code": "ENGL.G5.READIN.T2_INTENSIVE_READING.INFERENCE_QUESTIONS.M_INFER_CONTRADICTS",
     "listen_for": [
