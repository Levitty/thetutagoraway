   "key_step": "The child finds the words that show feeling and names the mood, checking it to the end.",
   "floor": {
    "prerequisite": "Reads feelings from cues.",
    "question": "A crying girl feels ...",
    "answer": "sad"
   },
   "steps": [
    "Find feeling words.",
    "Name the mood.",
    "Check whether it changes."
   ],
   "contexts": [
    "a choral verse",
    "a narrative about leisure"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write a verse that starts sad and ends happy."
    },
    {
     "beat": "point",
     "do": "Point at the last line.",
     "say": "Mood here?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child names the first mood."
    }
   ],
