   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"jam\" start like \"yam\"?",
    "answer": "no"
   },
   "steps": [
    "Say the sound alone.",
    "Say it in three words with pictures.",
    "Say two words that differ by one sound; the child points.",
    "Sort pictures by sound."
   ],
   "contexts": [
    "numbers: six and seven",
    "singing a number song"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Draw two pictures: jam, yam."
