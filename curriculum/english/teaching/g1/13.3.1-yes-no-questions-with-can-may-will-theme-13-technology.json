   "key_step": "The child puts can, may or will first to ask, and answers with yes or no and the same word.",
   "floor": {
    "prerequisite": "Uses do in questions.",
    "question": "Do you like tea?",
    "answer": "Yes, I do."
   },
   "steps": [
    "Model the pattern with real things or pictures.",
    "Say it together.",
    "The child fills the gap.",
    "The child makes a sentence."
   ],
   "contexts": [
    "technology: phones and radios",
    "asking to go out"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write or say: Can you swim?"
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "How do you answer?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
     "beat": "child_draws",
     "do": "The child says the whole sentence."
    },
    {
     "beat": "reveal",
     "do": "Say: Yes, I can. (or No, I cannot.)"
    }
   ],
