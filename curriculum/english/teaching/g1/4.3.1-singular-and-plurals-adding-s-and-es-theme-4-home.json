   "key_step": "The child counts: one, no -s; more, -s, or -es after s, x, ch, sh.",
   "floor": {
    "prerequisite": "Names things.",
    "question": "What is this? (a cup)",
    "answer": "a cup"
   },
   "steps": [
    "Model the pattern with real things or pictures.",
    "Say it together.",
    "The child fills the gap.",
    "The child makes a sentence."
   ],
   "contexts": [
    "things at home",
    "dishes and boxes"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write or say: One box, two ___"
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "boxs or boxes?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
     "beat": "child_draws",
     "do": "The child says the whole sentence."
    },
    {
     "beat": "reveal",
     "do": "Say: two boxes"
    }
   ],
