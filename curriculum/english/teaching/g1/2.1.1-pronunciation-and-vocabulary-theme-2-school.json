   "key_step": "The child listens for the sound (i to p), says it back, and matches it to the right word or picture.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"sheep\" start like \"ship\"?",
    "answer": "no"
   },
   "steps": [
    "Say the sound alone.",
    "Say it in three words with pictures.",
    "Say two words that differ by one sound; the child points.",
    "Sort pictures by sound."
   ],
   "contexts": [
    "things at school",
    "a pen and a pencil"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Draw two pictures: sheep, ship."
    },
    {
     "beat": "point",
     "do": "Say sheep.",
     "say": "Which one did I say?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child says the word back and traces its first letter."
    },
    {
     "beat": "reveal",
     "do": "Write sheep and underline the sound."
    }
   ],
