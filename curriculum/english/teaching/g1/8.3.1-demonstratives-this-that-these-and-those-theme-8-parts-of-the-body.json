   "key_step": "The child asks \"Near or far? One or many?\"",
   "floor": {
    "prerequisite": "Makes plurals.",
    "question": "One shoe, two ___",
    "answer": "shoes"
   },
   "steps": [
    "Model the pattern with real things or pictures.",
    "Say it together.",
    "The child fills the gap.",
    "The child makes a sentence."
   ],
   "contexts": [
    "parts of the body",
    "shoes and socks"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write or say: ___ are my shoes. (near)"
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "This or These?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
     "beat": "child_draws",
     "do": "The child says the whole sentence."
    },
    {
     "beat": "reveal",
     "do": "Say: These are my shoes."
    }
   ],
