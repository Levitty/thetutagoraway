   "key_step": "The child checks four things: back straight, feet down, book on the desk an arm away, good light.",
   "floor": {
    "prerequisite": "Holds a book the right way up.",
    "question": "Show me the front of the book.",
    "answer": "points to the cover"
   },
   "steps": [
    "Show pictures of good and poor posture.",
    "Act them.",
    "Choose the good one.",
    "Check posture before reading."
   ],
   "contexts": [
    "reading at home",
    "reading in class"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw a child sitting well and one slouching."
    },
    {
     "beat": "point",
     "do": "Point at both.",
     "say": "Which child can read well?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
