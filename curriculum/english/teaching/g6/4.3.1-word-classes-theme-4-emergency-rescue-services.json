     ],
     "ask": "Positive?",
     "repair": "Somebody."
    },
    {
     "code": "ENGL.G6.LANGUA.T4_WORD_CLASSES.INDEFINITE_PRONOUNS.M_IND_DOUBLE_NEG",
     "listen_for": [
      "nobody"
     ],
     "ask": "Two negatives?",
     "repair": "Anybody."
    },
    {
     "code": "ENGL.G6.LANGUA.T4_WORD_CLASSES.INDEFINITE_PRONOUNS.M_IND_PLURAL_VERB",
     "listen_for": [
      "are"
     ],
     "ask": "One or many?",
     "repair": "Is."
    },
    {
     "code": "ENGL.G6.LANGUA.T4_WORD_CLASSES.INDEFINITE_PRONOUNS.M_IND_NOONE",
     "listen_for": [
