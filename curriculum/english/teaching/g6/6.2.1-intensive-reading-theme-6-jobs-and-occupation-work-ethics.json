     ],
     "ask": "Is that from your life?",
     "repair": "Tell your own."
    },
    {
     "code": "ENGL.G6.READIN.T6_INTENSIVE_READING.RELATE_TO_LIFE.M6_RL_SURFACE",
     "listen_for": [
      "I also wear a school uniform."
     ],
     "ask": "Is that the main idea?",
     "repair": "Link the big idea."
