 "notes": "",
 "skills": [
  {
   "skill": "ENGL.G6.READIN.T6_INTENSIVE_READING.RELATE_TO_LIFE",
   "assessed_by": "teacher",
   "key_step": "The child names the main event, finds a real event like it, and says one likeness and one difference.",
   "floor": {
    "prerequisite": "Knows the events of a text.",
    "question": "What happened in the story?",
    "answer": "the main event"
   },
   "steps": [
    "Say the main event.",
    "Recall a time like it.",
    "Say how it is alike.",
    "Say how it is different."
   ],
   "contexts": [
    "work ethics",
    "lifestyle diseases",
    "leisure"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: In the text ... In my life ..."
    },
    {
     "beat": "point",
     "do": "Point at In my life.",
     "say": "When did you see someone work hard like this?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child gives one difference."
    }
   ],
   "misconceptions": [
    {
