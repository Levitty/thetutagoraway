     ],
     "ask": "How would the character say it?",
     "repair": "Say it like the character."
    },
    {
     "code": "ENGL.G3.READIN.T2_FLUENCY.READ_WITH_EXPRESSION.M3_RE_NO_PAUSE",
     "listen_for": [
      "It rained we stayed inside."
     ],
     "ask": "What does a full stop tell you?",
     "repair": "Stop and breathe."
    },
    {
     "code": "ENGL.G3.READIN.T2_FLUENCY.READ_WITH_EXPRESSION.M3_RE_QUESTION_FLAT",
     "listen_for": [
      "voice falls at clean"
     ],
     "ask": "What does the question mark tell your voice?",
     "repair": "Lift at the end."
    },
    {
     "code": "ENGL.G3.READIN.T2_FLUENCY.READ_WITH_EXPRESSION.M3_RE_SAID_VOICE",
     "listen_for": [
      "same voice for both parts"
