 "skills": [
  {
   "skill": "ENGL.G3.READIN.T2_FLUENCY.READ_WITH_EXPRESSION",
   "assessed_by": "voice",
   "key_step": "The child reads the marks: stop at a full stop, lift at a question mark, raise the voice at an exclamation mark, become the speaker inside quotation marks.",
   "floor": {
    "prerequisite": "Reads a sentence accurately.",
    "question": "Read: The dog runs.",
    "answer": "The dog runs."
   },
   "steps": [
    "Model reading with and without expression.",
    "Point at each mark and say what the voice does.",
    "The child reads one line.",
    "Read a dialogue in parts."
   ],
   "contexts": [
    "a dialogue between Hare and Lion",
    "a story read at assembly",
    "a poem about technology"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: \"Is that my phone?\" asked Mama. \"Yes!\" said Ali."
    },
    {
     "beat": "point",
     "do": "Point at the question mark.",
     "say": "Read with me, then on your own."
    },
    {
     "beat": "pause",
     "do": "Wait while the child reads."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the word he or she found hard."
    },
    {
     "beat": "reveal",
     "do": "Read it together once more."
    }
   ],
   "misconceptions": [
    {
     "code": "ENGL.G3.READIN.T2_FLUENCY.READ_WITH_EXPRESSION.M3_RE_FLAT",
     "listen_for": [
