   "key_step": "The child listens for the whole sound group (dr, fl, fr, gl), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"fly\" start like \"fry\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "a flag at the school gate",
    "fetching water with a drum",
    "washing a glass"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: fly, fry."
    },
    {
     "beat": "point",
     "do": "Say fly.",
     "say": "Listen: fl or fr?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the fl in fly."
    }
   ],
