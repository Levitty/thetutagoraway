   "key_step": "The child knows the irregular pairs by heart and never adds -s to them.",
   "floor": {
    "prerequisite": "Makes regular plurals.",
    "question": "One cup, two ___",
    "answer": "cups"
   },
   "steps": [
    "Show picture pairs.",
    "Say one and many.",
    "Sort regular and irregular.",
    "Use in sentences about occupations."
   ],
   "contexts": [
    "workers in our community",
    "a visit to the dentist",
    "sheep on a farm"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Two ___ are fixing the road. (man)"
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "Which word fits? mans or men?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
     "beat": "child_draws",
     "do": "The child writes the word in the gap."
    },
    {
     "beat": "reveal",
     "do": "Read: Two men are fixing the road."
    }
   ],
   "misconceptions": [
