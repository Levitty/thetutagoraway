 "skills": [
  {
   "skill": "ENGL.G3.LISTEN.T13_PRONUNCIATION_AND_VO.BLENDS_LF_RF_SPL",
   "assessed_by": "questions",
   "key_step": "The child listens for the whole sound group (-lf, -rf, spl-), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"splash\" start like \"sprash\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "saving coins in a box on the shelf",
    "a scarf bought with savings",
    "a splash of water"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: splash, sprash."
    },
    {
     "beat": "point",
     "do": "Say splash.",
     "say": "Listen: spl or spr?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the spl in splash."
    }
   ],
   "misconceptions": [
