   "key_step": "The child uses has for he, she, it; have for the rest; had for the past.",
   "floor": {
    "prerequisite": "Uses does and do.",
    "question": "She ___ her work. (do)",
    "answer": "does"
   },
   "steps": [
    "Show: I have, she has, we had.",
    "Point at the subject.",
    "Check the time.",
    "Say it aloud."
   ],
   "contexts": [
    "good manners at a meal",
    "what we own",
    "a visit last week"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Akinyi ___ two sisters."
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "Which word fits? have or has?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
     "beat": "child_draws",
     "do": "The child writes the word in the gap."
    },
    {
     "beat": "reveal",
     "do": "Read: Akinyi has two sisters."
    }
   ],
