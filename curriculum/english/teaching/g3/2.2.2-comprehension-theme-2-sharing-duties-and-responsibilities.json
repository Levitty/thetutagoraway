 "notes": "",
 "skills": [
  {
   "skill": "ENGL.G3.READIN.T2_COMPREHENSION.INDIRECT_QUESTIONS",
   "assessed_by": "questions",
   "key_step": "The child finds two clues, joins them, and says the answer with \"because\".",
   "floor": {
    "prerequisite": "Answers stated questions.",
    "question": "Akinyi cried. What did Akinyi do?",
    "answer": "She cried."
   },
   "steps": [
    "Read the text.",
    "Ask a why or how question.",
    "Find the clues.",
    "Join them: because ..."
   ],
   "contexts": [
    "a story about a lost goat",
    "a story about winning a race",
    "a story about saving"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Akinyi sat alone and cried when her goat got lost."
    },
    {
     "beat": "point",
     "do": "Point at the question.",
     "say": "How did Akinyi feel?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer and point to the clue."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the clue in the text."
    },
    {
     "beat": "reveal",
     "do": "Say: sad, because she cried"
    }
   ],
   "misconceptions": [
