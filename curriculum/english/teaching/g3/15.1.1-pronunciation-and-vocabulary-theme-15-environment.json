   "key_step": "The child listens for the whole sound group (scr-, qu), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"queen\" start like \"keen\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "scrubbing a dirty pot",
    "a quiet forest",
    "a queue at the water point"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: queen, keen."
    },
    {
     "beat": "point",
     "do": "Say queen.",
     "say": "Listen: qu or k?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the qu in queen."
    }
   ],
