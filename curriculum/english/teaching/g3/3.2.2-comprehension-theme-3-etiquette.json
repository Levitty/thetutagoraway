     ],
     "ask": "Is that what happened?",
     "repair": "Leave out what you think."
    },
    {
     "code": "ENGL.G3.READIN.T3_COMPREHENSION.SUMMARISE.M3_SU_ORDER",
     "listen_for": [
      "It grew. She planted a seed."
