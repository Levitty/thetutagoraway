   "assessed_by": "questions",
   "key_step": "The child tests each answer: does it cover the whole text, or only a part?",
   "floor": {
    "prerequisite": "Answers direct questions.",
    "question": "What did Juma sweep?",
    "answer": "the classroom"
   },
   "steps": [
    "Read the whole text.",
    "List what each part is about.",
    "Find what they share.",
    "Choose a title."
   ],
   "contexts": [
    "a text about safety at home",
    "a text about caring for pets",
    "a text about our environment"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Children help at home. They sweep, wash dishes and feed the hens."
    },
    {
     "beat": "point",
     "do": "Point at the question.",
     "say": "What is it mainly about?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer and point to the clue."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the clue in the text."
    },
    {
     "beat": "reveal",
     "do": "Say: how children help at home"
    }
   ],
   "misconceptions": [
