  {
   "skill": "ENGL.G3.READIN.T3_COMPREHENSION.SUMMARISE",
   "assessed_by": "questions",
   "key_step": "The child says who, what happened and how it ended, in order, in three sentences.",
   "floor": {
    "prerequisite": "Knows the main idea.",
    "question": "What is the story about?",
    "answer": "a boy saving money"
   },
   "steps": [
    "Read the story.",
    "Find the beginning, middle and end.",
    "Say one sentence for each.",
    "Cross out details."
   ],
   "contexts": [
    "a story about saving",
    "a text about a talent show",
    "a story about the environment"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Peter wanted a ball. He saved coins for weeks. At last he bought it."
    },
    {
     "beat": "point",
     "do": "Point at the question.",
     "say": "Summarise in two sentences."
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer and point to the clue."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the clue in the text."
    },
    {
     "beat": "reveal",
     "do": "Say: Peter saved coins for weeks. He bought a ball."
    }
   ],
   "misconceptions": [
    {
     "code": "ENGL.G3.READIN.T3_COMPREHENSION.SUMMARISE.M3_SU_EVERYTHING",
     "listen_for": [
