     "ask": "Do we need every detail?",
     "repair": "Three sentences only."
    },
    {
     "code": "ENGL.G3.READIN.T3_COMPREHENSION.SUMMARISE.M3_SU_ONE_DETAIL",
     "listen_for": [
      "The coins were in a tin."
     ],
     "ask": "Who, what, how did it end?",
     "repair": "Peter saved and bought a ball."
    },
    {
     "code": "ENGL.G3.READIN.T3_COMPREHENSION.SUMMARISE.M3_SU_OPINION",
     "listen_for": [
