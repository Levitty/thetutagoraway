     "ask": "Does it cover every part?",
     "repair": "Find the answer that covers all."
    },
    {
     "code": "ENGL.G3.READIN.T3_COMPREHENSION.MAIN_IDEA.M3_MI_TOO_WIDE",
     "listen_for": [
      "animals"
     ],
     "ask": "Is the whole text about all animals?",
     "repair": "No: a dog."
    },
    {
     "code": "ENGL.G3.READIN.T3_COMPREHENSION.MAIN_IDEA.M3_MI_FIRST_LINE",
     "listen_for": [
      "It was sunny."
     ],
     "ask": "Have you read it all?",
     "repair": "Decide at the end."
    },
    {
     "code": "ENGL.G3.READIN.T3_COMPREHENSION.MAIN_IDEA.M3_MI_PURPOSE",
     "listen_for": [
      "to tell a story"
