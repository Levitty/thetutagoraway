   "assessed_by": "questions",
   "key_step": "The child listens for the whole sound group (wr, pr, sm, st), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"stop\" start like \"top\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "writing our names",
    "children's rights in a poster",
    "a smile for a friend"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: stop, top."
    },
    {
     "beat": "point",
     "do": "Say stop.",
     "say": "Listen: st or t?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the st in stop."
    }
   ],
