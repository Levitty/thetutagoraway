   "key_step": "The child listens for the whole sound group (bl, br, cl, ch), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"blue\" start like \"brown\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "cleaning the classroom",
    "brushing teeth before school",
    "a chair at home"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: blue, brown."
    },
    {
     "beat": "point",
     "do": "Say blue.",
     "say": "Listen: bl or br?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the bl in blue."
    }
   ],
