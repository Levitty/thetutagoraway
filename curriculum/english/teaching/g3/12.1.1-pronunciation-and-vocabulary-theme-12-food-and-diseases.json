   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"grow\" start like \"crow\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "grains for good food",
    "the price of fruit",
    "a new cup"
   ],
