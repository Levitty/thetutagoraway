   "assessed_by": "questions",
   "key_step": "The child listens for the whole sound group (-mb, -nt, -nd, -nch), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"bent\" start like \"bend\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "a tent at a festival",
    "lunch at a wedding",
    "a band playing"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: bent, bend."
    },
    {
     "beat": "point",
     "do": "Say bent.",
     "say": "Listen: nt or nd?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the nt in bent."
    }
   ],
