   "assessed_by": "questions",
   "key_step": "The child listens for the whole sound group (spr, str), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"string\" start like \"spring\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "a strong singer",
    "spraying flowers",
    "a string for a guitar"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: string, spring."
    },
    {
     "beat": "point",
     "do": "Say string.",
     "say": "Listen: str or spr?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the str in string."
    }
   ],
