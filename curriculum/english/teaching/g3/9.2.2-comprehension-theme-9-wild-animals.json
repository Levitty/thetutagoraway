     "say": "What would you see?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer and point to the clue."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the clue in the text."
    },
    {
     "beat": "reveal",
     "do": "Say: a tall thin man, red hat, dusty road, dark sky"
    }
