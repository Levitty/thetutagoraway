   "steps": [
    "Read the description.",
    "Underline describing words.",
    "Close eyes and picture it.",
    "Draw it; check every word."
   ],
   "contexts": [
    "a text about wild animals in a park",
    "a festival at night",
    "a market morning"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: A tall, thin man in a red hat walked on a dusty road at night."
    },
    {
     "beat": "point",
