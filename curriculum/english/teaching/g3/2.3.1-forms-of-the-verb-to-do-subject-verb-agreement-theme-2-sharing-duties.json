   "assessed_by": "questions",
   "key_step": "The child chooses does for he, she, it; do for the rest; did for the past, and keeps the next verb plain.",
   "floor": {
    "prerequisite": "Uses am, is and are.",
    "question": "He ___ a boy.",
    "answer": "is"
   },
   "steps": [
    "Show: I do, she does, we did.",
    "Point at the subject.",
    "Check the time.",
    "Keep the verb plain after did."
   ],
   "contexts": [
    "sharing duties at home",
    "helping at school",
    "last weekend"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Did you ___ the plates? (wash)"
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "Which word fits? wash or washed?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
     "beat": "child_draws",
     "do": "The child writes the word in the gap."
    },
    {
     "beat": "reveal",
     "do": "Read: Did you wash the plates?"
    }
   ],
