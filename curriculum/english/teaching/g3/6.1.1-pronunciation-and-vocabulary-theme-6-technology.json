   "skill": "ENGL.G3.LISTEN.T6_PRONUNCIATION_AND_VO.BLENDS_DR_GR_SHR",
   "assessed_by": "questions",
   "key_step": "The child listens for the whole sound group (dr, gr, shr), not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Does \"shrink\" start like \"sink\"?",
    "answer": "no"
   },
   "steps": [
    "Say the target sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a short sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "driving a car",
    "a phone growing hot",
    "a shrub near the house"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: shrink, sink."
    },
    {
     "beat": "point",
     "do": "Say shrink.",
     "say": "Listen: shr or s?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word that was said and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the shr in shrink."
    }
   ],
