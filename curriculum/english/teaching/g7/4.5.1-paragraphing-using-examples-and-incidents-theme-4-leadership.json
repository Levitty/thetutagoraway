   "key_step": "The child supports a point with an example (for example) or an incident (one day), and keeps it on topic.",
   "floor": {
    "prerequisite": "Writes narrative paragraphs.",
    "question": "Write a topic sentence.",
    "answer": "a topic sentence"
   },
   "steps": [
    "Point.",
    "For example ...",
    "Incident: One day ...",
    "Check it supports the point."
   ],
   "contexts": [
    "leadership"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Our school values honesty."
    },
    {
     "beat": "point",
     "do": "Point at honesty.",
     "say": "Give an incident."
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child gives an example."
    }
   ],
