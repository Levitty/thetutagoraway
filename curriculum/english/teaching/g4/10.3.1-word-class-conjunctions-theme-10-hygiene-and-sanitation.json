   "skill": "ENGL.G4.LANGUA.T10_WORD_CLASS_CONJUNCTI.CONJUNCTIONS",
   "assessed_by": "questions",
   "key_step": "The child asks how the two ideas are linked before choosing and, but, because, so or or.",
   "floor": {
    "prerequisite": "Joins with and and but.",
    "question": "Join: I ran. I fell.",
    "answer": "I ran and I fell."
   },
   "steps": [
    "Same direction: and.",
    "Against: but.",
    "Reason: because.",
    "Result: so.",
    "Choice: or."
   ],
   "contexts": [
    "a hygiene talk",
    "a dialogue at break"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: I washed my hands ___ they were dirty."
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "Is it a reason or a result?"
    },
    {
     "beat": "pause",
     "do": "Wait for because."
    },
    {
     "beat": "child_draws",
     "do": "The child writes a sentence with so."
    }
   ],
