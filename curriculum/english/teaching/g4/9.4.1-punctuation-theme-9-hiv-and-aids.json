  {
   "skill": "ENGL.G4.WRITIN.T9_PUNCTUATION.QUESTION_MARKS",
   "assessed_by": "questions",
   "key_step": "The child asks \"is someone being asked something?\" before choosing the end mark.",
   "floor": {
    "prerequisite": "Uses full stops.",
    "question": "End a statement.",
    "answer": "full stop"
   },
   "steps": [
    "Is it asking?",
    "Yes: question mark.",
    "No: full stop."
   ],
   "contexts": [
    "a class interview",
    "a health quiz"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Where is the clinic"
    },
    {
     "beat": "point",
     "do": "Point at the end.",
     "say": "Is it asking?"
    },
    {
     "beat": "pause",
     "do": "Wait for a question mark."
    },
    {
     "beat": "child_draws",
     "do": "The child writes a statement with where in it."
    }
   ],
   "misconceptions": [
