 "skills": [
  {
   "skill": "ENGL.G4.WRITIN.T9_PUNCTUATION.COMMAS",
   "assessed_by": "questions",
   "key_step": "The child puts a comma between items in a list and and before the last.",
   "floor": {
    "prerequisite": "Uses full stops.",
    "question": "End this: We ate",
    "answer": "We ate."
   },
   "steps": [
    "Find the list.",
    "Comma after each item.",
    "And before the last, no comma."
   ],
   "contexts": [
    "a shopping list",
    "a farm story"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: We bought rice beans maize"
    },
    {
     "beat": "point",
     "do": "Point between rice and beans.",
     "say": "What goes here?"
    },
    {
     "beat": "pause",
     "do": "Wait for a comma."
    },
    {
     "beat": "child_draws",
     "do": "The child finishes the list."
    }
   ],
   "misconceptions": [
    {
     "code": "ENGL.G4.WRITIN.T9_PUNCTUATION.COMMAS.M_COM_NO_COMMA_LIST",
     "listen_for": [
      "Mama bought rice beans and maize."
     ],
     "ask": "Where do items meet?",
     "repair": "A comma."
    },
    {
     "code": "ENGL.G4.WRITIN.T9_PUNCTUATION.COMMAS.M_COM_AFTER_LAST",
     "listen_for": [
      "I like mangoes, oranges, bananas,"
     ],
     "ask": "Is that the last item?",
     "repair": "Full stop."
    },
    {
     "code": "ENGL.G4.WRITIN.T9_PUNCTUATION.COMMAS.M_COM_SPLIT_SENTENCE",
     "listen_for": [
      "Wafula, kicked the ball."
     ],
     "ask": "Is it a list?",
     "repair": "No comma."
    },
    {
     "code": "ENGL.G4.WRITIN.T9_PUNCTUATION.COMMAS.M_COM_FULL_STOP_LIST",
     "listen_for": [
      "We saw lions. zebras. and giraffes."
     ],
     "ask": "Is the sentence over?",
     "repair": "Commas."
    }
   ],
   "checks": [
    {
     "question": "Punctuate: I like tea milk and juice",
     "answer": "I like tea, milk and juice.",
     "shows": "list"
    },
    {
     "question": "Is there a comma after the last item?",
     "answer": "No",
     "shows": "last item"
