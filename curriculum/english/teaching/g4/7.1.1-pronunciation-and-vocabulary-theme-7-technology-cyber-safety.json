   "assessed_by": "questions",
   "key_step": "The child hears the time word (yesterday, last week) and uses the past form.",
   "floor": {
    "prerequisite": "Uses do and did.",
    "question": "Did you eat?",
    "answer": "Yes, I did."
   },
   "steps": [
    "Find the time word.",
    "Regular: -ed.",
    "Irregular: learn it.",
    "After did: plain verb."
   ],
   "contexts": [
    "a chat about yesterday",
    "a phone call"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Yesterday I ___ to school. (go)"
    },
    {
     "beat": "point",
     "do": "Point at Yesterday.",
     "say": "Now or past?"
    },
    {
     "beat": "pause",
     "do": "Wait for went."
    },
    {
     "beat": "child_draws",
     "do": "The child writes a question with did."
    }
   ],
