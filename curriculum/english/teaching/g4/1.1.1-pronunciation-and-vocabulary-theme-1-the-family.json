  {
   "skill": "ENGL.G4.LISTEN.T1_PRONUNCIATION_AND_VO.LISTEN_ATTENTIVE",
   "assessed_by": "voice",
   "key_step": "The child listens for the answer to who, what, where and when, holding the events in order.",
   "floor": {
    "prerequisite": "Follows a three-step instruction.",
    "question": "Stand up, clap twice, sit down.",
    "answer": "does all three in order"
   },
   "steps": [
    "Say what to listen for.",
    "Read the text once.",
    "Ask the questions.",
    "Read again to check."
   ],
   "contexts": [
    "a school assembly notice",
    "a story told by a grandmother",
    "a radio announcement"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: who, what, where, when."
    },
    {
     "beat": "point",
     "do": "Point at who.",
     "say": "Listen: who is the story about?"
    },
    {
     "beat": "pause",
     "do": "Read the text; wait for the answer."
    },
    {
     "beat": "predict",
     "do": "Ask: what will happen next?"
    }
   ],
