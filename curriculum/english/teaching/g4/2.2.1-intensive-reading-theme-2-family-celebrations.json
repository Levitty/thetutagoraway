     ],
     "ask": "Does the text talk about it?",
     "repair": "Yes, differently: False."
    },
    {
     "code": "ENGL.G4.READIN.T2_INTENSIVE_READING.FACTUAL_QUESTIONS.M_FACT_NOT_STATED_AS_TRUE",
     "listen_for": [
      "True"
     ],
     "ask": "Can you find it?",
     "repair": "No: Not stated."
    },
    {
     "code": "ENGL.G4.READIN.T2_INTENSIVE_READING.FACTUAL_QUESTIONS.M_FACT_WRONG_WHO",
     "listen_for": [
      "his teacher"
     ],
     "ask": "Who did the action?",
     "repair": "The doer."
    }
   ],
   "checks": [
    {
     "question": "True, False or Not stated: the text does not mention rain.",
     "answer": "Not stated",
