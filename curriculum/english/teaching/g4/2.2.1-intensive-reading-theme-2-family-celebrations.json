  {
   "skill": "ENGL.G4.READIN.T2_INTENSIVE_READING.INFERENCE_QUESTIONS",
   "assessed_by": "questions",
   "key_step": "The child finds the clue in the text and says what it tells us that the text does not say.",
   "floor": {
    "prerequisite": "Answers direct questions.",
    "question": "What did Amina buy?",
    "answer": "a stated answer"
   },
   "steps": [
    "Find the clue.",
    "Ask what it shows.",
    "Check the answer fits the text."
   ],
   "contexts": [
    "a story about a birthday",
    "a poem about a celebration"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Juma slammed the door."
    },
    {
     "beat": "point",
     "do": "Point at slammed.",
     "say": "How does Juma feel?"
    },
    {
     "beat": "pause",
     "do": "Wait for angry."
    },
    {
     "beat": "reveal",
     "do": "Show that slammed is the clue."
    }
   ],
   "misconceptions": [
