    {
     "code": "ENGL.G4.READIN.T2_INTENSIVE_READING.CONTEXT_CLUES.M_CTX_COMMON_MEANING",
     "listen_for": [
      "big baskets"
     ],
     "ask": "Does the usual meaning fit here?",
     "repair": "Check the sentence."
    },
    {
     "code": "ENGL.G4.READIN.T2_INTENSIVE_READING.CONTEXT_CLUES.M_CTX_OPPOSITE",
     "listen_for": [
      "very new"
