  {
   "skill": "ENGL.G4.READIN.T2_INTENSIVE_READING.CONTEXT_CLUES",
   "assessed_by": "questions",
   "key_step": "The child reads the sentences around the word and tries a meaning that fits there.",
   "floor": {
    "prerequisite": "Uses picture clues.",
    "question": "What does the picture show?",
    "answer": "a description"
   },
   "steps": [
    "Find the word.",
    "Read before and after.",
    "Try a meaning.",
    "Check it fits."
   ],
   "contexts": [
    "a story with a new word",
    "a newspaper sentence"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: The old hut was dilapidated; its roof had fallen in."
    },
    {
     "beat": "point",
     "do": "Point at the part after the semicolon.",
     "say": "What clue does it give?"
    },
    {
     "beat": "pause",
     "do": "Wait for an answer."
    },
    {
     "beat": "predict",
     "do": "Ask: so what does dilapidated mean?"
    }
   ],
   "misconceptions": [
    {
