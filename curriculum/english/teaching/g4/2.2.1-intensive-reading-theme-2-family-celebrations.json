  {
   "skill": "ENGL.G4.READIN.T2_INTENSIVE_READING.FACTUAL_QUESTIONS",
   "assessed_by": "questions",
   "key_step": "The child finds the words in the text that answer the question and checks them.",
   "floor": {
    "prerequisite": "Answers direct questions.",
    "question": "Who is in the story?",
    "answer": "a name from the text"
   },
   "steps": [
    "Read the question.",
    "Find the key word in the text.",
    "Read the sentence around it.",
    "Answer from the text only."
   ],
   "contexts": [
    "a story about a family celebration",
    "a notice about etiquette"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write a short text and a question."
    },
    {
     "beat": "point",
     "do": "Point at the key word.",
     "say": "Where is it in the text?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to find it."
    },
    {
     "beat": "reveal",
     "do": "Underline the sentence that answers."
    }
   ],
   "misconceptions": [
