     "code": "ENGL.G4.READIN.T2_INTENSIVE_READING.INFERENCE_QUESTIONS.M4_INFER_FEELING_GUESS",
     "listen_for": [
      "tired"
     ],
     "ask": "What is the clue?",
     "repair": "Find it first."
    }
   ],
   "checks": [
