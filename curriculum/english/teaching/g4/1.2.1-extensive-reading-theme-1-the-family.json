   "key_step": "The child looks at the second and third letters to order words, then checks the guide words.",
   "floor": {
    "prerequisite": "Knows alphabetical order.",
    "question": "Which comes first: cat or dog?",
    "answer": "cat"
   },
   "steps": [
    "Order by first letter.",
    "If the same, use the second letter.",
    "Use the guide words.",
    "Choose the meaning that fits."
   ],
   "contexts": [
    "a school dictionary",
    "a word wall in class"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: bat, bag, ball."
    },
    {
     "beat": "point",
     "do": "Point at the second letters.",
     "say": "They are the same. Look at the third letter."
    },
    {
     "beat": "pause",
     "do": "Wait for the order."
    },
    {
     "beat": "child_draws",
     "do": "The child writes bag, ball, bat."
    }
   ],
