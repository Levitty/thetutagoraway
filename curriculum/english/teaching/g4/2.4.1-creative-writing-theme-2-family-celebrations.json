   "key_step": "The child plans a beginning, middle and end on the topic before writing.",
   "floor": {
    "prerequisite": "Orders sentences in a paragraph.",
    "question": "Order: We ate. We cooked.",
    "answer": "We cooked. We ate."
   },
   "steps": [
    "Read the topic.",
    "List three ideas on it.",
    "Order them.",
    "Write and check each sentence fits."
   ],
   "contexts": [
    "a family celebration",
    "my best day",
    "a visit to the market"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write the topic: A family celebration."
    },
    {
     "beat": "point",
     "do": "Point at the topic.",
     "say": "Give me one idea that fits."
    },
    {
     "beat": "pause",
     "do": "Wait for an idea."
    },
    {
     "beat": "child_draws",
     "do": "The child writes two more ideas and numbers them."
    }
   ],
