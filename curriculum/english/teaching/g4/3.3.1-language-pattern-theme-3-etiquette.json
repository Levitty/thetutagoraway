   "skill": "ENGL.G4.LANGUA.T3_LANGUAGE_PATTERN.POLITE_PATTERN",
   "assessed_by": "questions",
   "key_step": "The child puts the plain verb after May I or Could you and keeps the question order.",
   "floor": {
    "prerequisite": "Uses polite words.",
    "question": "Ask for water politely.",
    "answer": "May I have water, please?"
   },
   "steps": [
    "May I + plain verb.",
    "Could you + plain verb.",
    "Would you like + noun or to + verb."
   ],
   "contexts": [
    "asking a teacher",
    "offering a visitor tea"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Could you ___ me, please? (help)"
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "What form of help?"
    },
    {
     "beat": "pause",
     "do": "Wait for help."
    },
    {
     "beat": "child_draws",
     "do": "The child writes a Would you like question."
    }
   ],
   "misconceptions": [
