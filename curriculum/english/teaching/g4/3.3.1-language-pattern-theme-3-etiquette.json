     "listen_for": [
      "to come"
     ],
     "ask": "What comes after may I?",
     "repair": "The plain verb."
    },
    {
     "code": "ENGL.G4.LANGUA.T3_LANGUAGE_PATTERN.POLITE_PATTERN.M_PAT_NO_PLEASE",
     "listen_for": [
      "Give me water."
     ],
     "ask": "Is it a command?",
     "repair": "Could you ..., please?"
    },
    {
     "code": "ENGL.G4.LANGUA.T3_LANGUAGE_PATTERN.POLITE_PATTERN.M_PAT_WOULD_LIKE_FORM",
     "listen_for": [
      "Do"
     ],
     "ask": "Is it an offer?",
     "repair": "Would you like."
    },
    {
     "code": "ENGL.G4.LANGUA.T3_LANGUAGE_PATTERN.POLITE_PATTERN.M_PAT_ORDER",
     "listen_for": [
      "help you"
     ],
     "ask": "Is it a question?",
     "repair": "Could you help."
    }
   ],
