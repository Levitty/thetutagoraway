 "skills": [
  {
   "skill": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVES",
   "assessed_by": "questions",
   "key_step": "The child asks which word tells us more about the noun.",
   "floor": {
    "prerequisite": "Knows nouns.",
    "question": "Find the thing: a red bus.",
    "answer": "bus"
   },
   "steps": [
    "Find the noun.",
    "Find the word that describes it.",
    "Check it answers what kind."
   ],
   "contexts": [
    "food at the market",
    "animals"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: The tall girl ate a sweet mango."
    },
    {
     "beat": "point",
     "do": "Point at girl.",
     "say": "Which word tells us about her?"
    },
    {
     "beat": "pause",
     "do": "Wait for tall."
    },
    {
     "beat": "child_draws",
     "do": "The child finds sweet."
    }
   ],
   "misconceptions": [
    {
     "code": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVES.M_ADJ_NOUN_AS_ADJ",
     "listen_for": [
      "bus"
     ],
     "ask": "Is it the thing?",
     "repair": "Find the describing word."
    },
    {
     "code": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVES.M_ADJ_VERB_AS_ADJ",
     "listen_for": [
      "ran"
     ],
     "ask": "Is it an action?",
     "repair": "Not an adjective."
    },
    {
     "code": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVES.M_ADJ_ADVERB_AS_ADJ",
     "listen_for": [
      "slowly"
     ],
     "ask": "Does it tell how?",
     "repair": "That is an adverb."
    },
    {
     "code": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVES.M_ADJ_ARTICLE_AS_ADJ",
     "listen_for": [
      "a"
     ],
     "ask": "Does a describe?",
     "repair": "No: find the describing word."
    }
   ],
   "checks": [
    {
     "question": "Adjective in: a hot cup of tea",
     "answer": "hot",
     "shows": "adjective"
    },
    {
     "question": "Adjective in: The boy ran fast.",
     "answer": "none",
     "shows": "adverb not adjective"
    }
   ]
  },
  {
   "skill": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVE_ORDER",
   "assessed_by": "questions",
   "key_step": "The child puts size first, then shape, then colour, then the noun.",
   "floor": {
    "prerequisite": "Finds adjectives.",
    "question": "Find two adjectives: a big round ball.",
    "answer": "big, round"
   },
   "steps": [
    "Size.",
    "Shape.",
    "Colour.",
    "Noun."
   ],
   "contexts": [
    "fruit at the market",
    "a ball in sports"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: a ___ ___ pumpkin (round, big)."
    },
    {
     "beat": "point",
     "do": "Point at big.",
     "say": "Size or shape?"
    },
    {
     "beat": "pause",
     "do": "Wait for size."
    },
    {
     "beat": "child_draws",
     "do": "The child writes: a big round pumpkin."
    }
   ],
   "misconceptions": [
    {
     "code": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVE_ORDER.M_ADO_SHAPE_BEFORE_SIZE",
