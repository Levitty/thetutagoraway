     "ask": "Do we need and?",
     "repair": "No."
    },
    {
     "code": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVE_ORDER.M4_ADO_COLOUR_FIRST",
     "listen_for": [
      "red big"
     ],
     "ask": "Size or colour first?",
     "repair": "Size."
    }
   ],
   "checks": [
