      "round big"
     ],
     "ask": "Which is size?",
     "repair": "Size first."
    },
    {
     "code": "ENGL.G4.LANGUA.T5_WORD_CLASSES_ADJECTI.ADJECTIVE_ORDER.M_ADO_AFTER_NOUN",
     "listen_for": [
      "ball big"
     ],
     "ask": "Where do adjectives go?",
     "repair": "Before the noun."
