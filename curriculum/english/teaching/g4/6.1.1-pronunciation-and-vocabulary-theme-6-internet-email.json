  },
  {
   "skill": "ENGL.G4.LISTEN.T6_PRONUNCIATION_AND_VO.INTONATION",
   "assessed_by": "voice",
   "key_step": "The child hears whether the voice goes up or down at the end and copies it.",
   "floor": {
    "prerequisite": "Asks WH questions.",
    "question": "Make a question with where.",
    "answer": "Where is ...?"
   },
   "steps": [
    "Say a statement; the voice falls.",
    "Say a yes or no question; it rises.",
    "Say a WH question; it falls."
   ],
   "contexts": [
    "asking a friend about email",
    "a visitor at the gate",
    "a phone call"
   ],
   "board": [
    {
     "beat": "draw",
     "do": "Draw arrows: down for statements, up for yes or no."
    },
    {
     "beat": "point",
     "do": "Point at the up arrow.",
     "say": "Say: Do you have a phone?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to say it rising."
    },
    {
     "beat": "child_draws",
     "do": "The child draws the arrow for Where is the inbox?"
    }
   ],
   "misconceptions": [
