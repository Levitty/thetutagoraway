      "attachment"
     ],
     "ask": "What do you do with it?",
     "repair": "Match the action."
    },
    {
     "code": "ENGL.G4.LISTEN.T6_PRONUNCIATION_AND_VO.INTERNET_WORDS.M_NET_PASSWORD_SHARED",
     "listen_for": [
      "friends"
     ],
     "ask": "Who should know it?",
     "repair": "No one but a trusted adult."
    },
    {
     "code": "ENGL.G4.LISTEN.T6_PRONUNCIATION_AND_VO.INTERNET_WORDS.M_NET_STRANGER",
     "listen_for": [
      "tell him"
     ],
     "ask": "Do you know the person?",
     "repair": "Tell an adult."
    },
    {
     "code": "ENGL.G4.LISTEN.T6_PRONUNCIATION_AND_VO.INTERNET_WORDS.M4_NET_DOWNLOAD_UPLOAD",
     "listen_for": [
      "download"
     ],
     "ask": "Up or down?",
     "repair": "Up goes out."
    }
   ],
   "checks": [
    {
     "question": "A file sent with an email is an ...",
     "answer": "attachment",
     "shows": "word"
