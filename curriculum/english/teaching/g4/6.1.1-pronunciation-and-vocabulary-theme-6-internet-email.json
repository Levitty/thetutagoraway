  {
   "skill": "ENGL.G4.LISTEN.T6_PRONUNCIATION_AND_VO.INTERNET_WORDS",
   "assessed_by": "questions",
   "key_step": "The child explains each internet word by what you do with it, and the safe choice.",
   "floor": {
    "prerequisite": "Knows phone words.",
    "question": "What do you send from a phone?",
    "answer": "a message"
   },
   "steps": [
    "Name the word.",
    "Say what you do with it.",
    "Say the safe rule."
   ],
   "contexts": [
    "sending an email",
    "a stranger online"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: inbox, attachment, password."
    },
    {
     "beat": "point",
     "do": "Point at password.",
     "say": "Who can you share it with?"
    },
    {
     "beat": "pause",
     "do": "Wait for the answer."
    },
    {
     "beat": "child_draws",
     "do": "The child matches inbox to its meaning."
    }
   ],
   "misconceptions": [
    {
     "code": "ENGL.G4.LISTEN.T6_PRONUNCIATION_AND_VO.INTERNET_WORDS.M_NET_NEAR_MEANING",
