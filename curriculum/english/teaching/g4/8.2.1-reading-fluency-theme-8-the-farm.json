   "floor": {
    "prerequisite": "Reads Grade 3 words.",
    "question": "Read: The cow is big.",
    "answer": "reads it"
   },
   "steps": [
    "Model the text.",
    "Read together.",
    "Child reads alone.",
    "Reread for speed and expression."
   ],
   "contexts": [
    "a story about a farm",
    "a poem with proverbs",
    "a dialogue"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: The cows went down / to the river."
    },
    {
     "beat": "point",
     "do": "Point at the slash.",
     "say": "Read up to here, then on."
    },
    {
     "beat": "pause",
     "do": "Wait for the child to read."
    },
    {
     "beat": "child_draws",
     "do": "The child marks the pauses in the next sentence."
    }
   ],
   "misconceptions": [
