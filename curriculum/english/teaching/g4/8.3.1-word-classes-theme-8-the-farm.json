  {
   "skill": "ENGL.G4.LANGUA.T8_WORD_CLASSES.CONTRACTIONS",
   "assessed_by": "questions",
   "key_step": "The child puts the apostrophe where the letters were left out.",
   "floor": {
    "prerequisite": "Knows the full forms.",
    "question": "do not",
    "answer": "do not"
   },
   "steps": [
    "Write the full form.",
    "Cross out the missing letter.",
    "Put the apostrophe there."
   ],
   "contexts": [
    "a farm notice",
    "a text message"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: is not."
    },
    {
     "beat": "point",
     "do": "Point at the o in not.",
     "say": "This letter goes."
    },
    {
     "beat": "pause",
     "do": "Wait for isn't."
    },
    {
     "beat": "child_draws",
     "do": "The child writes don't."
    }
   ],
   "misconceptions": [
