   "floor": {
    "prerequisite": "Answers inference questions.",
    "question": "What does the clue show?",
    "answer": "an inference"
   },
   "steps": [
    "Interpret: what does it mean?",
    "Evaluate: is it true or fair?",
    "Give reasons from the text."
   ],
   "contexts": [
    "marine life articles"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two questions: meaning and reliability."
    },
