   "assessed_by": "questions",
   "key_step": "The child spots where a blunt word could hurt and swaps in a gentle expression that keeps the meaning.",
   "floor": {
    "prerequisite": "Uses gender-neutral words.",
    "question": "Neutral word for chairman?",
    "answer": "chairperson"
   },
   "steps": [
    "Find the blunt word.",
    "Choose a euphemism.",
    "Check the meaning stays clear."
   ],
   "contexts": [
    "condolences",
    "talking about age or jobs"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: died, old, jobless."
    },
    {
     "beat": "point",
     "do": "Point at died.",
     "say": "A gentler word?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to answer."
    },
    {
     "beat": "child_draws",
     "do": "The child replaces the others."
    }
   ],
   "misconceptions": [
