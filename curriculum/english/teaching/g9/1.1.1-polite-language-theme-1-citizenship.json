     "ask": "Is it clear enough?",
     "repair": "Give the facts."
    },
    {
     "code": "ENGL.G9.LISTEN.T1_POLITE_LANGUAGE.EUPHEMISM.M9_EU_INSULT",
     "listen_for": [
      "old-timer"
     ],
     "ask": "Would they like it?",
     "repair": "Senior citizen."
    }
   ],
   "checks": [
