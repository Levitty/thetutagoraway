     "listen_for": [
      "He works two jobs."
     ],
     "ask": "Two jobs?",
     "repair": "No job now."
    },
    {
     "code": "ENGL.G9.LISTEN.T1_POLITE_LANGUAGE.EUPHEMISM.M9_EU_OVERUSE",
     "listen_for": [
      "take a little when you feel like it"
