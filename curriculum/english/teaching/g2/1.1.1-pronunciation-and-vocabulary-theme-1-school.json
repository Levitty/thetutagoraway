   "key_step": "The child listens for the target sound (bl, sp, sc, sk, ck) in the whole word, not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Do \"scarf\" and \"shirt\" sound the same?",
    "answer": "no"
   },
   "steps": [
    "Say the sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "a desk in school",
    "a black school bag"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: scarf, shirt."
    },
    {
     "beat": "point",
     "do": "Say scarf.",
     "say": "Which word did I say?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the sound in scarf."
    }
   ],
