   "floor": {
    "prerequisite": "Uses the present continuous.",
    "question": "I ___ watering. (am)",
    "answer": "am"
   },
   "steps": [
    "Show the pattern on the board.",
    "Read examples together.",
    "Fill gaps.",
    "Make own sentences."
   ],
   "contexts": [
    "working in the garden",
    "what we were doing when it rained"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Yesterday at four she ___ cooking."
