   "key_step": "The child listens for the target sound (k, sn, sp, u) in the whole word, not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Do \"cup\" and \"cap\" sound the same?",
    "answer": "no"
   },
   "steps": [
    "Say the sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "children at home doing safe chores",
    "a snack in the kitchen"
   ],
   "board": [
    {
