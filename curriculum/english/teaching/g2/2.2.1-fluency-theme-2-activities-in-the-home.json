   "floor": {
    "prerequisite": "Reads a sentence accurately.",
    "question": "Read: I am happy.",
    "answer": "I am happy."
   },
   "steps": [
    "Model reading flat and with feeling.",
    "Find the feeling word or mark.",
    "The child reads one line.",
    "Read a dialogue in parts."
   ],
   "contexts": [
    "a story about an accident",
    "caring for a sick friend",
    "a cultural dance"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: \"Oh no! My cup is broken!\" cried Achieng."
    },
    {
     "beat": "point",
     "do": "Point at cried.",
     "say": "Read with me, then on your own."
    },
    {
     "beat": "pause",
     "do": "Wait while the child reads."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the word that was hard."
    },
    {
     "beat": "reveal",
     "do": "Read it together once more."
    }
