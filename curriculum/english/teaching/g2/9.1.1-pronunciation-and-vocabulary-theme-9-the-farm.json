   "assessed_by": "questions",
   "key_step": "The child listens for the target sound (cr, er, long a and i, y as ee, ar) in the whole word, not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Do \"bird\" and \"bad\" sound the same?",
    "answer": "no"
   },
   "steps": [
    "Say the sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "a farmer with crops",
    "a puppy on the farm"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: bird, bad."
    },
    {
     "beat": "point",
     "do": "Say bird.",
     "say": "Which word did I say?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the sound in bird."
    }
   ],
