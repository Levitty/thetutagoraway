   "key_step": "The child finds a clue in the title or picture and says what will happen and why.",
   "floor": {
    "prerequisite": "Says what is in a picture.",
    "question": "What is the girl doing?",
    "answer": "She is calling."
   },
   "steps": [
    "Read the title; look at the pictures.",
    "Ask what will happen and why.",
    "Read on and check.",
    "Say if the guess was right."
   ],
   "contexts": [
    "The Lost Goat",
    "Our New Garden",
    "a story about a market day"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: Title: The Broken Pot. Picture: a boy holding pieces."
    },
    {
     "beat": "point",
     "do": "Point at the question.",
     "say": "What will the story be about?"
    },
    {
     "beat": "pause",
     "do": "Wait for the answer and the clue."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the clue."
    },
    {
     "beat": "reveal",
     "do": "Say: A boy breaks a pot and may say sorry."
    }
   ],
