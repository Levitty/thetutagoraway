   "skill": "ENGL.G2.LISTEN.T2_PRONUNCIATION_AND_VO.CH_OA_SH_CL",
   "assessed_by": "questions",
   "key_step": "The child listens for the target sound (ch, long o, sh, cl) in the whole word, not only the first letter, and picks the word that has it.",
   "floor": {
    "prerequisite": "Hears the first sound of a word.",
    "question": "Do \"coat\" and \"cot\" sound the same?",
    "answer": "no"
   },
   "steps": [
    "Say the sound alone, then in words.",
    "Say two words that differ by one sound; the child picks one.",
    "Find the sound in a sentence.",
    "Sort picture cards by sound."
   ],
   "contexts": [
    "washing dishes at home",
    "soap and a clean shirt"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write two words: coat, cot."
    },
    {
     "beat": "point",
     "do": "Say coat.",
     "say": "Which word did I say?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to point."
    },
    {
     "beat": "child_draws",
     "do": "The child circles the word and says it back."
    },
    {
     "beat": "reveal",
     "do": "Underline the sound in coat."
    }
   ],
