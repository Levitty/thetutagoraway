     "listen_for": [
      "were"
     ],
     "ask": "One person?",
     "repair": "Was."
    },
    {
     "code": "ENGL.G2.LANGUA.T1_VERB_TO_BE_PAST_TENS.WAS_WERE.M2_WW_IS_PAST",
     "listen_for": [
      "is"
     ],
     "ask": "Now or last week?",
     "repair": "Was."
    },
    {
     "code": "ENGL.G2.LANGUA.T1_VERB_TO_BE_PAST_TENS.WAS_WERE.M2_WW_CHILDREN_WAS",
     "listen_for": [
      "was"
     ],
     "ask": "One child or many?",
     "repair": "Were."
