  {
   "skill": "ENGL.G2.LANGUA.T1_VERB_TO_BE_PAST_TENS.WAS_WERE",
   "assessed_by": "questions",
   "key_step": "The child asks \"One or more?\" and chooses was or were.",
   "floor": {
    "prerequisite": "Uses am, is and are.",
    "question": "We ___ friends. (are or is?)",
    "answer": "are"
   },
   "steps": [
    "Show the pattern on the board.",
    "Read examples together.",
    "Fill gaps.",
    "Make own sentences."
   ],
   "contexts": [
    "yesterday at school",
    "last week at home"
   ],
   "board": [
    {
     "beat": "write",
     "do": "Write: We ___ in the library."
    },
    {
     "beat": "point",
     "do": "Point at the gap.",
     "say": "was or were?"
    },
    {
     "beat": "pause",
     "do": "Wait for the child to choose."
    },
    {
     "beat": "child_draws",
     "do": "The child writes the word in the gap."
    },
    {
     "beat": "reveal",
     "do": "Read: We were in the library."
    }
   ],
