     "say": "How did Tom feel?"
    },
    {
     "beat": "pause",
     "do": "Wait for the answer and the clue."
    },
    {
     "beat": "child_draws",
     "do": "The child underlines the clue."
    },
    {
     "beat": "reveal",
     "do": "Say: happy, because he smiled and clapped"
    }
